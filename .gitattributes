# Icon images are content-addressed and stored with Git LFS (docs/recipe-browser/icons.md).
# CI checks out without LFS and sees pointer files; only the site deploy fetches them.
icons/*/*.png filter=lfs diff=lfs merge=lfs -text
# Config defaults snapshots are what the mods write, byte for byte (docs/config-defaults.md):
# never convert their line endings.
mods-src/seraphhorizons/assets/seraphhorizons/config/configdefaults/** -text
