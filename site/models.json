{
  "_comment": "The model viewer's models (#/models). Paths are from the repository's root; the build copies the files into the site. See docs/recipe-browser/models.md.",
  "models": [
    {
      "id": "bucking-sawmill",
      "title": "Bucking sawmill",
      "description": "The Seraph Horizons mod's bucking sawmill: two drag saws on a shared crankshaft, lowered and wound back up by a windlass, that cross-cut trunks into logs. Generated by mods-src/seraphhorizons/BuckingSawmill/tools/make_shape.py.",
      "credit": "Most of this model was made for the Seraph Horizons mod. Its gears, saw blades, saw heads and cranks are from Immersive Woodworking's sawmill model by Bobrik00, used with permission; those parts are not covered by the repository's license.",
      "creditUrl": "https://github.com/benjamin-kirkbride/Seraph-Horizons/blob/main/mods-src/seraphhorizons/CREDITS.md",
      "shape": "mods-src/seraphhorizons/assets/seraphhorizons/shapes/block/buckingmill.json",
      "rig": "mods-src/seraphhorizons/assets/seraphhorizons/config/buckingmill-rig.json",
      "scenario": {
        "inputs": {
          "theta": { "label": "Shaft angle" },
          "depth": { "label": "Saw depth", "hint": "0 is the top of the cycle, 1 is through the trunk at the bed" },
          "lifting": { "label": "Going up (lift clutch in)" },
          "reverse": { "label": "Shaft turns backwards" }
        },
        "requires": {
          "crankshaft": "Crankshaft",
          "sash1": "Sash 1",
          "sash2": "Sash 2",
          "blade": "Blade kit",
          "levers": "Levers"
        },
        "prop": {
          "label": "Trunk loaded at the top",
          "on": "trunkBed",
          "default": "thick",
          "colour": "#8b5a2b",
          "options": [
            { "id": "thin", "label": "Thin (xs to lg), shown 1×1×4", "size": [4, 1, 1] },
            { "id": "thick", "label": "Thick (xl, xxl), shown 2×2×5", "size": [5, 2, 2] }
          ]
        },
        "play": {
          "secondsPerTurn": 1.2,
          "edge": { "top": "saw.topY", "bottom": "saw.bottomY" },
          "phases": [
            { "id": "raising", "label": "Winding up", "lifting": 1, "to": 0, "turns": 6, "prop": "clear", "next": "drop", "nextWithoutProp": "sinking", "startIf": { "lifting": 1 } },
            { "id": "drop", "label": "Dropping onto the trunk", "to": "contact", "seconds": 0.4, "prop": "load", "next": "cutting", "startIf": { "prop": true, "depthAtMost": 0.08 } },
            { "id": "cutting", "label": "Cutting", "to": 1, "turns": 8, "next": "raising" },
            { "id": "sinking", "label": "Coming down, no trunk", "to": 1, "turns": 6, "prop": "clear", "next": "raising", "startIf": {} }
          ]
        }
      }
    }
  ]
}
