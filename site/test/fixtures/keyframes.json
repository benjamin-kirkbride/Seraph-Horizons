      ]
    },
    {
      "name": "Spin",
      "code": "spin",
      "quantityframes": 40,
      "onActivityStopped": "Stop",
      "onAnimationEnd": "Repeat",
      "keyframes": [
        { "frame": 0, "elements": { "wheel": { "rotationX": 350, "rotationY": 0, "rotationZ": 0, "rotShortestDistanceX": true, "stretchX": 1, "stretchY": 1, "stretchZ": 1 }, "arm": { "rotationX": 0, "rotationY": 350, "rotationZ": 0 } } },
        { "frame": 20, "elements": { "wheel": { "rotationX": 10, "rotationY": 0, "rotationZ": 0, "rotShortestDistanceX": true, "stretchX": 1, "stretchY": 2, "stretchZ": 1 }, "arm": { "rotationX": 0, "rotationY": 10, "rotationZ": 0 } } }
      ]
    },
    {
      "name": "Drop",
      "code": "drop",
      "quantityframes": 10,
      "onActivityStopped": "PlayTillEnd",
      "onAnimationEnd": "Hold",
      "keyframes": [
        { "frame": 0, "elements": { "base": { "offsetX": 0, "offsetY": 0, "offsetZ": 0 } } },
        { "frame": 9, "elements": { "base": { "offsetX": 0, "offsetY": -4, "offsetZ": 0 } } }
      ]
    }
  ]
