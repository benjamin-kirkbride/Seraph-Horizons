  "animations": [
    {
      "name": "Swing",
      "code": "swing",
      "quantityframes": 20,
      "onActivityStopped": "EaseOut",
      "onAnimationEnd": "Repeat",
      "keyframes": [
        { "frame": 0, "elements": { "arm": { "rotationX": 0, "rotationY": 0, "rotationZ": 0 } } },
        { "frame": 10, "elements": { "arm": { "rotationX": 0, "rotationY": 0, "rotationZ": 90 }, "hand": { "rotationX": 0, "rotationY": 0, "rotationZ": -90 } } },
