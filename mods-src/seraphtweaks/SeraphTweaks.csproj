<Project Sdk="Microsoft.NET.Sdk">

  <!-- Client and server mod holding the pack's own gameplay tweaks to other mods (README.md
       here). Built from this repo, uploaded to the ModDB by hand, and pinned in pack.toml like
       any other mod. Atlas scenarios load this build instead of the pinned copy. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SeraphTweaks</AssemblyName>
    <RootNamespace>SeraphHorizons.SeraphTweaks</RootNamespace>
    <!-- Keep equal to modinfo.json's version; tools/tests/test_mods_src.py checks it. -->
    <Version>1.0.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Atlas copies a mod folder by its name: a plain bin/Debug would land in the same
         TestMods/Debug as another mods-src mod, and the game loads neither. -->
    <OutputPath>bin/$(Configuration)/seraphtweaks/</OutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- The tweaked mods are not referenced: each tweak finds its targets by name at run time,
       so the mod builds from the game alone and a tweak whose mod is missing or changed is
       skipped with a warning. -->
  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VINTAGE_STORY)/Lib/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <None Include="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- build/seraphtweaks_<version>.zip, for the ModDB upload: the DLL, modinfo.json and
       assets/ at the top level, as the game loads it. -->
  <Target Name="ModZip" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_ZipStage>$(IntermediateOutputPath)modzip/</_ZipStage>
      <_ZipOut>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', 'build', 'seraphtweaks_$(Version).zip'))</_ZipOut>
    </PropertyGroup>
    <RemoveDir Directories="$(_ZipStage)" />
    <ItemGroup>
      <_ZipAsset Include="assets/**" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetPath);modinfo.json" DestinationFolder="$(_ZipStage)" />
    <Copy SourceFiles="@(_ZipAsset)" DestinationFolder="$(_ZipStage)assets/%(RecursiveDir)" />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_ZipOut)'))" />
    <ZipDirectory SourceDirectory="$(_ZipStage)" DestinationFile="$(_ZipOut)" Overwrite="true" />
    <Message Importance="high" Text="mod zip: $(_ZipOut)" />
  </Target>

</Project>
