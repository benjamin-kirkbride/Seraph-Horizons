<Project Sdk="Microsoft.NET.Sdk">

  <!-- The mine planner's real speed (#1232), never a test: the unit tests bound its checkpoints in units
       of work (MineWork), the same on any machine, and this measures what a unit costs here. It
       compiles the eidolon's game-independent code (../Eidolon/Core, and ../Machines/Core it uses)
       directly, as the tests do, and needs neither the game nor the pack. Run it on a quiet machine:
       `dotnet run -c Release (project) mods-src/seraphhorizons/benchmarks`, optionally followed by
       the number of runs and the areas to run (README "Eidolon", mining).
       CI only builds it. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Eidolon/Core/**/*.cs" Link="Eidolon/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Machines/Core/**/*.cs" Link="Machines/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../TidyVariants/Core/**/*.cs" Link="TidyVariants/Core/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
