// Hydrate or Diedrate values for Expanded Foods foods it leaves out, seraphhorizons' FoodHydration
// switch (README.md). Its patterns pemmicanfish-*, pemmicancrab-*, pemmicansnake-* and gelatinfish-*
// match no item: the codes are fishpemmican, crabpemmican, snakepemmican and gelatinfish (no
// variants). The values are the ones those patterns meant. Server side (hydration-game.json says why).
[
  // Every state, as expandedfoods:pemmican-* (-25).
  { "file": "expandedfoods:itemtypes/food/mixing/pemmicanfish.json", "op": "addmerge", "path": "/attributes", "value": { "hydration": -25 }, "side": "server", "dependsOn": [{ "modid": "hydrateordiedrate" }, { "modid": "expandedfoods" }] },
  { "file": "expandedfoods:itemtypes/food/primitivesurvival/mixing/pemmicancrab.json", "op": "addmerge", "path": "/attributes", "value": { "hydration": -25 }, "side": "server", "dependsOn": [{ "modid": "hydrateordiedrate" }, { "modid": "expandedfoods" }] },
  { "file": "expandedfoods:itemtypes/food/primitivesurvival/mixing/pemmicansnake.json", "op": "addmerge", "path": "/attributes", "value": { "hydration": -25 }, "side": "server", "dependsOn": [{ "modid": "hydrateordiedrate" }, { "modid": "expandedfoods" }] },
  // As expandedfoods:gelatin-* (+1).
  { "file": "expandedfoods:itemtypes/food/gelatinfish.json", "op": "addmerge", "path": "/attributes", "value": { "hydration": 1 }, "side": "server", "dependsOn": [{ "modid": "hydrateordiedrate" }, { "modid": "expandedfoods" }] },
  // Sliced fruit leather (the only state eaten by itself), as dried fruit (dryfruit-*,
  // dehydratedfruit-*) and fruit bars (fruitbar-*), -5.
  { "file": "expandedfoods:itemtypes/food/fruitleather.json", "op": "addmerge", "path": "/attributes", "value": { "hydrationByType": { "*-sliced": -5 } }, "side": "server", "dependsOn": [{ "modid": "hydrateordiedrate" }, { "modid": "expandedfoods" }] }
]
