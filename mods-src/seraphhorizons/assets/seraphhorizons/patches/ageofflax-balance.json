// Age of Flax (ageofflaxfork) rebalance, seraphhorizons' AgeOfFlaxRebalance switch (README.md).
// Age of Flax reads this file again in every tool's OnLoaded, after the patches are applied.
// Ripple and hatchel roll once per use (a Gaussian of avg and var, rounded at random) and multiply
// by the bundles processed, so these are per bundle. A ripe plant drops 1.2 bundles on average;
// vanilla's ripe flax drops grain avg 3 and fibers avg 4. Per plant: primitive 2/3 of vanilla,
// simple the same, advanced 4/3. The seeds drop from the plant again (vanilla 1.2), not the ripple.
[
  { "file": "ageofflax:config/balance.json", "op": "replace", "path": "/ripple/primitive/seedDropAvg", "value": 0, "side": "universal", "dependsOn": [{ "modid": "ageofflaxfork" }] },
  { "file": "ageofflax:config/balance.json", "op": "replace", "path": "/ripple/primitive/grainDropAvg", "value": 1.6667, "side": "universal", "dependsOn": [{ "modid": "ageofflaxfork" }] },
  { "file": "ageofflax:config/balance.json", "op": "replace", "path": "/ripple/primitive/grainDropVar", "value": 0.25, "side": "universal", "dependsOn": [{ "modid": "ageofflaxfork" }] },
  { "file": "ageofflax:config/balance.json", "op": "replace", "path": "/ripple/simple/seedDropAvg", "value": 0, "side": "universal", "dependsOn": [{ "modid": "ageofflaxfork" }] },
  { "file": "ageofflax:config/balance.json", "op": "replace", "path": "/ripple/simple/grainDropAvg", "value": 2.5, "side": "universal", "dependsOn": [{ "modid": "ageofflaxfork" }] },
  { "file": "ageofflax:config/balance.json", "op": "replace", "path": "/ripple/simple/grainDropVar", "value": 0.4, "side": "universal", "dependsOn": [{ "modid": "ageofflaxfork" }] },
  { "file": "ageofflax:config/balance.json", "op": "replace", "path": "/ripple/advanced/seedDropAvg", "value": 0, "side": "universal", "dependsOn": [{ "modid": "ageofflaxfork" }] },
  { "file": "ageofflax:config/balance.json", "op": "replace", "path": "/ripple/advanced/grainDropAvg", "value": 3.3333, "side": "universal", "dependsOn": [{ "modid": "ageofflaxfork" }] },
  { "file": "ageofflax:config/balance.json", "op": "replace", "path": "/ripple/advanced/grainDropVar", "value": 0.5, "side": "universal", "dependsOn": [{ "modid": "ageofflaxfork" }] },
  { "file": "ageofflax:config/balance.json", "op": "replace", "path": "/hatchel/primitive/fiberDropAvg", "value": 2.2222, "side": "universal", "dependsOn": [{ "modid": "ageofflaxfork" }] },
  { "file": "ageofflax:config/balance.json", "op": "replace", "path": "/hatchel/primitive/fiberDropVar", "value": 0.35, "side": "universal", "dependsOn": [{ "modid": "ageofflaxfork" }] },
  { "file": "ageofflax:config/balance.json", "op": "replace", "path": "/hatchel/simple/fiberDropAvg", "value": 3.3333, "side": "universal", "dependsOn": [{ "modid": "ageofflaxfork" }] },
  { "file": "ageofflax:config/balance.json", "op": "replace", "path": "/hatchel/simple/fiberDropVar", "value": 0.5, "side": "universal", "dependsOn": [{ "modid": "ageofflaxfork" }] },
  { "file": "ageofflax:config/balance.json", "op": "replace", "path": "/hatchel/advanced/fiberDropAvg", "value": 4.4444, "side": "universal", "dependsOn": [{ "modid": "ageofflaxfork" }] },
  { "file": "ageofflax:config/balance.json", "op": "replace", "path": "/hatchel/advanced/fiberDropVar", "value": 0.65, "side": "universal", "dependsOn": [{ "modid": "ageofflaxfork" }] }
]
