  {"file": "seraphhorizons:blocktypes/buckingmill/frame.json", "op": "add", "path": "/behaviors", "value": [{"name": "CarryableInteract", "properties": {"allowedCarryables": [{"class": "BlockTreeTrunk"}]}}], "side": "server", "dependsOn": [{"modid": "carryon"}]},
