// Trunk entities with Carry On (TrunkEntities/Game/TrunkCarry.cs). TrunkEntitySystem empties this
// file while trunk entities do not run.
// - Logging Expanded's own patch gives the tree trunk a Carryable (slot Hands, server side). This
//   second one is merged into it by Carry On (overrideExistingProperties with a higher
//   patchPriority, so the order of the two patches does not matter): Logging Expanded's animations
//   for a trunk held as an item (its heldTpIdleAnimation), trunkcarry for sizes xs to lg and
//   trunkcarryheavy for xl and xxl, in place of Carry On's holdheavy, which Logging Expanded's own
//   patch leaves. Only lg (a thin trunk) and xxl (a thick one) are ever carried: TrunkCarry gives
//   Carry On the block of the trunk's class's model (TrunkCarry.Shown) and keeps the real one in
//   its attributes, so the two animations are thin and thick. No transform of its own: the block
//   gets Carry On's default (half size about its centre), as with Logging Expanded alone, whose
//   patch sets none either. The trunk block already lies along z; the transforms this patch had
//   before (Carry On's carry-trunk template, then a rotationX of 90 for a trunk wrongly taken to
//   stand upright) stood it on end in first person and lifted it off the shoulder in third. In
//   third person Carry On hangs the block on its FrontCarry point, on the left forearm, so the
//   animation's raised left arm is what puts it at the shoulder. No swap to the back (trunks are
//   Hands only: TrunkCarry also strips any Back slot and lays a trunk found on a back down), and
//   no walk speed of Carry On's own: the pack sets the walk speed from the trunk's logs. Server
//   side: the client gets the blocks from it.
//   The game merges propertiesByType into properties (arrays concatenated), so the shared settings
//   are in properties only.
// - The trunk entity types get the pack's pick-up (sneak + right click, EntityBehaviorTrunkCarry).
[
  {
    "file": "loggingmod:blocktypes/treetrunk.json", "op": "add", "path": "/behaviors/-", "side": "server",
    "value": {
      "name": "Carryable",
      "properties": {
        "patchPriority": 1,
        "overrideExistingProperties": true,
        "preventSwapBack": true
      },
      "propertiesByType": {
        "*-xs-*": { "slots": { "Hands": { "animation": "trunkcarry", "walkSpeedModifier": 0 } } },
        "*-sm-*": { "slots": { "Hands": { "animation": "trunkcarry", "walkSpeedModifier": 0 } } },
        "*-md-*": { "slots": { "Hands": { "animation": "trunkcarry", "walkSpeedModifier": 0 } } },
        "*-lg-*": { "slots": { "Hands": { "animation": "trunkcarry", "walkSpeedModifier": 0 } } },
        "*-xl-*": { "slots": { "Hands": { "animation": "trunkcarryheavy", "walkSpeedModifier": 0 } } },
        "*-xxl-*": { "slots": { "Hands": { "animation": "trunkcarryheavy", "walkSpeedModifier": 0 } } }
      }
    },
    "dependsOn": [{ "modid": "loggingmod" }, { "modid": "carryon" }]
  },
  {"file": "seraphhorizons:entities/trunk-thin.json", "op": "add", "path": "/server/behaviors/-", "value": {"code": "seraphhorizons.trunkcarry"}, "dependsOn": [{"modid": "carryon"}]},
  {"file": "seraphhorizons:entities/trunk-thick.json", "op": "add", "path": "/server/behaviors/-", "value": {"code": "seraphhorizons.trunkcarry"}, "dependsOn": [{"modid": "carryon"}]}
]
