// The eidolon's creative spawner (Eidolon/, README "Eidolon"): the game's creature item, which spawns
// seraphhorizons:eidolon where it is used. The eidolon takes the player who placed it as its owner
// (setGuardedEntityAttribute: EntityLaborEidolon.OnEntitySpawn). Creative only: no recipe, no trader. The
// server disables it with the Eidolon switch off.
{
	code: "creature-eidolon",
	class: "ItemCreature",
	maxstacksize: 1,
	creativeinventory: { "general": ["*"], "creatures": ["*"] },
	shape: { base: "seraphhorizons:entity/eidolon/eidolon" },
	attributes: {
		setGuardedEntityAttribute: true,
		handbook: { exclude: true },
	},
	// The model's middle is at (-0.18, 1.88, 0.49) blocks (it faces -x, 3.75 blocks tall); every form
	// turns about it, and held, the translation brings it back to the hand (tests/HeldTransformTests.cs).
	guiTransform: {
		translation: { x: 0, y: 0, z: 0 },
		rotation: { x: -20, y: -45, z: 180 },
		origin: { x: -0.18, y: 1.88, z: 0.49 },
		scale: 0.26,
	},
	tpHandTransform: {
		translation: { x: 1.17, y: -11.57, z: -2.1 },
		origin: { x: -0.18, y: 1.88, z: 0.49 },
		scale: 0.15,
	},
	groundTransform: {
		origin: { x: -0.18, y: 0, z: 0.49 },
		scale: 0.6,
	},
}
