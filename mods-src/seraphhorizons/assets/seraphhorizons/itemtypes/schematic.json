// The machines' schematics (#469, README "Schematics", config/schematic-gates.json): one per
// machine, kept on crafting by the recipes they gate, sold by traders. The game's schematic sheet
// and its two drawings: the glider's for wooden machines and vehicles, the translocator's for gear
// and metal work.
{
	code: "schematic",
	maxstacksize: 1,
	behaviors: [
		{ name: "GroundStorable", properties: { layout: "SingleCenter", collisionBox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.125, z2: 1 } } }
	],
	variantgroups: [
		{ code: "machine", states: [
			"windmill", "waterwheel", "handcrank", "transmission", "helvehammer", "pulverizer",
			"sawmill", "chopper", "buckingmill", "rosser", "gearbox", "centeredspurgear",
			"panningmachine", "cablecar", "biplane"
		] }
	],
	attributes: {
		groundStorageTransform: {
			rotation: { x: 0, y: 7, z: 0 },
			origin: { x: 0.5, y: 0, z: 0.5 }
		},
		displaycaseable: true,
		shelvable: true
	},
	shape: { base: "game:item/utility/schematic-glider" },
	texturesByType: {
		"*-transmission": { "map-blank": { base: "game:item/utility/map-blank" }, "schematic": { base: "game:item/utility/schematic-customtranslocator" } },
		"*-helvehammer": { "map-blank": { base: "game:item/utility/map-blank" }, "schematic": { base: "game:item/utility/schematic-customtranslocator" } },
		"*-pulverizer": { "map-blank": { base: "game:item/utility/map-blank" }, "schematic": { base: "game:item/utility/schematic-customtranslocator" } },
		"*-gearbox": { "map-blank": { base: "game:item/utility/map-blank" }, "schematic": { base: "game:item/utility/schematic-customtranslocator" } },
		"*-centeredspurgear": { "map-blank": { base: "game:item/utility/map-blank" }, "schematic": { base: "game:item/utility/schematic-customtranslocator" } },
		"*-panningmachine": { "map-blank": { base: "game:item/utility/map-blank" }, "schematic": { base: "game:item/utility/schematic-customtranslocator" } },
		"*-handcrank": { "map-blank": { base: "game:item/utility/map-blank" }, "schematic": { base: "game:item/utility/schematic-customtranslocator" } },
		"*": { "map-blank": { base: "game:item/utility/map-blank" }, "schematic": { base: "game:item/utility/schematic-glider" } }
	},
	creativeinventory: { "general": ["*"], "items": ["*"] },
	guiTransform: {
		translation: { x: 0, y: 0, z: 0 },
		rotation: { x: -54, y: -24, z: -180 },
		origin: { x: 0.5, y: 0.1, z: 0.5 },
		scaleXyz: { x: -1.3, y: 1.3, z: 1.3 }
	},
	groundTransform: {
		translation: { x: 0, y: 0, z: 0 },
		rotation: { x: 0, y: 0, z: 0 },
		origin: { x: 0.5, y: -0.02, z: 0.5 },
		scale: 1.8
	},
	tpHandTransform: {
		translation: { x: -1.3, y: -0.7, z: -1.2 },
		rotation: { x: -57, y: -165, z: 92 },
		origin: { x: 0.4, y: 0.2, z: 0.4 }
	}
}
