// Aqua fortis for the acid parting vessel (AcidParting/, README "Ore processing: the acid parting vessel"; #931, #740):
// the game's nitric acid (game:acid-full-nitric, which Expanded Matter enables), distilled the period's way from
// saltpeter and oil of vitriol, the game's sulfuric acid (itself cooked from saltpeter and sulfur powder, the stall
// roaster's sulfur). KNO3 + H2SO4 gives HNO3 and potassium bisulfate. Expanded Matter's own recipes (saltpeter, alum
// and copper sulfate) stay. The server disables it with AcidParting or OreProcessing off.
[
	{
		code: "aquafortis",
		perishableProps: {
			type: "None",
			freshHours: { avg: 72 },
			transitionHours: { avg: 72 },
			transitionRatio: 1,
			transitionedStack: { type: "item", code: "game:acid-full-nitric" }
		},
		shape: { base: "game:block/food/meal/liquid" },
		ingredients: [
			{
				code: "saltpeter", minQuantity: 1, maxQuantity: 1,
				validStacks: [ { type: "item", code: "game:saltpeter", quantity: 2 } ]
			},
			{
				code: "sulfuricacid", minQuantity: 1, maxQuantity: 1,
				validStacks: [ { type: "item", code: "game:acid-full-sulfuric", shapeElement: "bowl/water" } ],
				portionSizeLitres: 1
			}
		],
		cooksInto: { type: "item", code: "game:acid-full-nitric", quantity: 100 }
	}
]
