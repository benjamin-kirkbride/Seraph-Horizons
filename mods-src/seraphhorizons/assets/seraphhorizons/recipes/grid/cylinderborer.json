// The cylinder borer (#639; CylinderBorer/, README "Cylinder borer"). The server disables these with
// CylinderBorer off.
[
	{
		// The frame: oak sills and posts (logs) and bearers (planks), iron ways and fittings (two plates
		// in one slot, two rods in one), bolted up with 12 nails and strips, with a hammer: iron, meteoric
		// iron or steel, as the draw bench's. Two stainless gears pay for the gearing the frame carries:
		// the entry shaft's pinion and its drive (#473); the great wheel the pinion turns comes with the
		// boring bar. Every other working part goes in afterwards, fitted by hand at the frame: the bushings
		// are the game's metal parts, the boring bar and the feed take their materials directly, stage by
		// stage (config/builds/cylinderborer.json), and the cutter head is smithed.
		ingredientPattern: "MHG,LNL,PRP",
		width: 3,
		height: 3,
		ingredients: {
			"M": { type: "item", code: "game:metalplate-*", allowedVariants: ["iron", "meteoriciron", "steel"], quantity: 2 },
			"G": { type: "item", code: "seraphhorizons:gear-stainless", quantity: 2 },
			"R": { type: "item", code: "game:rod-*", allowedVariants: ["iron", "meteoriciron", "steel"], quantity: 2 },
			"N": { type: "item", code: "game:metalnailsandstrips-*", allowedVariants: ["iron", "meteoriciron", "steel"], quantity: 12 },
			"L": { type: "block", code: "game:log-placed-oak-ud" },
			"P": { type: "item", code: "game:plank-oak" },
			"H": { type: "item", code: "game:hammer-*", isTool: true }
		},
		output: { type: "block", code: "seraphhorizons:cylinderborer-frame-north" }
	}
]
