// The vanner (Vanner/, README "Vanner"; #923). The server disables it with Vanner or OreProcessing off.
[
	{
		// The frame, as placed: the sills, the countershaft's pedestals and bearings, the feed box's and
		// spray pipe's posts and the concentrate and tailings boxes (5 planks of timber and boards), with
		// the uprights' cheeks, brackets and saddle (4 iron and 1 steel nails and strips), with a hammer
		// (Vanner/README.md, "Build stages", the frame's row). Every other stage goes in afterwards,
		// fitted by hand.
		ingredientPattern: "PNS,_H_",
		width: 3,
		height: 2,
		ingredients: {
			"P": { type: "item", code: "game:plank-*", quantity: 5 },
			"N": { type: "item", code: "game:metalnailsandstrips-iron", quantity: 4 },
			"S": { type: "item", code: "game:metalnailsandstrips-steel", quantity: 1 },
			"H": { type: "item", code: "game:hammer-*", isTool: true }
		},
		output: { type: "block", code: "seraphhorizons:vanner-north" }
	}
]
