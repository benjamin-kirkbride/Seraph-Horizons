// seraphhorizons' UnifiedPipes switch (README.md "Unified pipes"): closing open chute sections. Two
// open sections of copper or lead (seraphhorizons:chutesectionopen-*, folded from a plate on the
// press brake), soldered shut along their seams with two tin or silver solder bars and a soldering
// iron (2 durability, as the game's own soldering), make two of the game's chute sections of that
// metal. The game's one-step "plate + solder + soldering iron + hammer" recipe is switched off
// (patches/unifiedpipes-chutesection.json). Marked disabled by UnifiedPipesSystem with the switch off.
[
  {
    "name": "Chute section soldered shut from two open sections",
    "ingredientPattern": "IO,SO",
    "ingredients": {
      "O": { "type": "item", "code": "seraphhorizons:chutesectionopen-*", "name": "metal", "allowedVariants": ["copper", "lead"], "quantity": 1 },
      "S": { "type": "item", "code": "game:solderbar-*", "name": "solder", "allowedVariants": ["tin", "silver"], "quantity": 2 },
      "I": { "type": "item", "code": "game:solderingiron", "isTool": true, "toolDurabilityCost": 2 }
    },
    "width": 2,
    "height": 2,
    "output": { "type": "item", "code": "game:chutesection-{metal}", "quantity": 2 }
  }
]
