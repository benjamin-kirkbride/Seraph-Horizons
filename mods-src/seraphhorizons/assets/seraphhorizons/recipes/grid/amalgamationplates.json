// The amalgamation plates (AmalgamationPlates/, README "Ore processing: the amalgamation plates"; #917). The
// server disables it with AmalgamationPlates or OreProcessing off.
[
	{
		// The frame, as placed: the oak sills, posts and trestles (4 support beams), the plank bed with its side
		// boards, the distributor and the tail box (12 planks), nailed with 2 iron nails and strips, with a hammer
		// (AmalgamationPlates/README.md, "Build stages", the frame's row). Every other stage goes in afterwards,
		// fitted by hand.
		ingredientPattern: "BPN,_H_",
		width: 3,
		height: 2,
		ingredients: {
			"B": { type: "block", code: "game:supportbeam-*", quantity: 4 },
			"P": { type: "item", code: "game:plank-*", quantity: 12 },
			"N": { type: "item", code: "game:metalnailsandstrips-iron", quantity: 2 },
			"H": { type: "item", code: "game:hammer-*", isTool: true }
		},
		output: { type: "block", code: "seraphhorizons:amalgamationplates-north" }
	}
]
