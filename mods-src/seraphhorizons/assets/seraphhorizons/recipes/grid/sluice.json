// The sluice (Sluice/, README "Sluice"; #734). The server disables it with Sluice or OreProcessing off.
[
	{
		// The frame, as placed: the head box, the sluice box and its tail board, the concentrate launder
		// (8 planks of boards) on its legs, bearers and three trestles (2 support beams of timber), nailed up
		// with 3 iron nails and strips, with a hammer (Sluice/README.md, "Build stages", the frame's row).
		// The riffles and the services go in afterwards, fitted by hand.
		ingredientPattern: "PBP,_HN",
		width: 3,
		height: 2,
		ingredients: {
			"P": { type: "item", code: "game:plank-*", quantity: 4 },
			"B": { type: "block", code: "game:supportbeam-*", quantity: 2 },
			"N": { type: "item", code: "game:metalnailsandstrips-iron", quantity: 3 },
			"H": { type: "item", code: "game:hammer-*", isTool: true }
		},
		output: { type: "block", code: "seraphhorizons:sluice-north" }
	}
]
