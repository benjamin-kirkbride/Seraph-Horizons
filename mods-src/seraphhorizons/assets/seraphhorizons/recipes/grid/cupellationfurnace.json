// The cupellation furnace (CupellationFurnace/, README "Ore processing: the cupellation furnace"; #740). The server
// disables it with CupellationFurnace or OreProcessing off.
[
	{
		// The iron frame, as placed: the angle binding, the grate, the lintels, jambs and guides, the tuyere and its
		// wind box (3 iron plates, 4 iron rods, 12 iron nails and strips), with a hammer (CupellationFurnace/README.md,
		// "The build", the frame's row; the rig's build.frame). The brickwork, the lining and the fittings go in
		// afterwards, fitted by hand, then the test.
		ingredientPattern: "PRN,_H_",
		width: 3,
		height: 2,
		ingredients: {
			"P": { type: "item", code: "game:metalplate-iron", quantity: 3 },
			"R": { type: "item", code: "game:rod-iron", quantity: 4 },
			"N": { type: "item", code: "game:metalnailsandstrips-iron", quantity: 12 },
			"H": { type: "item", code: "game:hammer-*", isTool: true }
		},
		output: { type: "block", code: "seraphhorizons:cupellationfurnace-north" }
	}
]
