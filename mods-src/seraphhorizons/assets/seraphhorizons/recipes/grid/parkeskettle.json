// The Parkes kettle (ParkesKettle/, README "Ore processing: the Parkes kettle"; #927). The server disables it
// with ParkesKettle or OreProcessing off.
[
	{
		// The iron frame, as placed: the angle-iron binding, the grate and the cast-iron front (2 iron plates,
		// 4 iron rods, 10 iron nails and strips), with a hammer (ParkesKettle/README.md, "The build", the frame's
		// row; the rig's build.frame). The brickwork, the lining, the kettle and the stirrer go in afterwards,
		// fitted by hand.
		ingredientPattern: "PRN,_H_",
		width: 3,
		height: 2,
		ingredients: {
			"P": { type: "item", code: "game:metalplate-iron", quantity: 2 },
			"R": { type: "item", code: "game:rod-iron", quantity: 4 },
			"N": { type: "item", code: "game:metalnailsandstrips-iron", quantity: 10 },
			"H": { type: "item", code: "game:hammer-*", isTool: true }
		},
		output: { type: "block", code: "seraphhorizons:parkeskettle-north" }
	}
]
