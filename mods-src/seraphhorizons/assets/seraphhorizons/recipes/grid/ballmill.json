// The ball mill (BallMill/, README "Ore processing: the ball mill"; #915). The server disables it with
// BallMill or OreProcessing off.
[
	{
		// The frame, as placed: the granite bed (2 stone brick blocks), the cast pedestals, bearings and the
		// pinion's pillow blocks (4 iron plates), bolted down with 5 iron nails and strips, with a hammer
		// (BallMill/README.md, "Build stages", the frame's row). Every other stage goes in afterwards, fitted by
		// hand.
		ingredientPattern: "BPN,_H_",
		width: 3,
		height: 2,
		ingredients: {
			"B": { type: "block", code: "game:stonebricks-*", quantity: 2 },
			"P": { type: "item", code: "game:metalplate-iron", quantity: 4 },
			"N": { type: "item", code: "game:metalnailsandstrips-iron", quantity: 5 },
			"H": { type: "item", code: "game:hammer-*", isTool: true }
		},
		output: { type: "block", code: "seraphhorizons:ballmill-north" }
	}
]
