// seraphhorizons' UnifiedPipes switch (README.md "Unified pipes"): the grid recipes of Pipes and
// Power Expanded's pipes once its plate-and-nails and valve recipes are off. Pipe is made from the
// game's chute sections in the game's own chute patterns (two side by side, an elbow, a T, a cross).
// Copper and lead sections take what a chute takes (patches/unifiedpipes-chutesection.json: a tin or
// silver solder bar per section and a soldering iron) and a hammer, which is what tells a pipe from a
// chute on the grid; iron and steel ones are banded with nails and strips of their metal and a hammer.
// Two sections make two straight pipes; 2, 3 and 4 make a bend, a T- and an X-junction. Bronze valves
// from one straight pipe of any metal and a bronze ingot (and a plate of the same bronze for the
// pressure valve's gate). Marked disabled by UnifiedPipesSystem with the switch off.
[
  {
    "name": "Piping (Straight) soldered from chute sections",
    "ingredientPattern": "PP,SI,H_",
    "ingredients": {
      "P": {
        "type": "item",
        "code": "game:chutesection-*",
        "name": "metal",
        "allowedVariants": [
          "copper",
          "lead"
        ],
        "quantity": 1
      },
      "S": {
        "type": "item",
        "code": "game:solderbar-*",
        "name": "solder",
        "allowedVariants": [
          "tin",
          "silver"
        ],
        "quantity": 2
      },
      "I": {
        "type": "item",
        "code": "game:solderingiron",
        "isTool": true,
        "toolDurabilityCost": 2
      },
      "H": {
        "type": "item",
        "code": "game:hammer-*",
        "isTool": true
      }
    },
    "width": 2,
    "height": 3,
    "output": {
      "type": "block",
      "code": "ppex:pipe-straight-ns-{metal}",
      "quantity": 2
    }
  },
