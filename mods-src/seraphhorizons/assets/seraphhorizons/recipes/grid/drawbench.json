// The draw bench (DrawBench/, README "Draw bench"). The server disables it with DrawBench off.
[
	{
		// The frame: oak sills (logs) and an oak bed (planks) on which iron ways (two rods, in one
		// slot) carry the die stock and the drive head's pedestals (plates), bolted up with nails and
		// strips, with a hammer: iron, meteoric iron or steel, as the other frames. Two steel gears pay
		// for the gearing the frame carries: the rectifier's train (A1, A2, B1, B2 and the idler), the
		// return shaft's gear and the barrel gear. Every other working part goes in afterwards, fitted
		// by hand.
		ingredientPattern: "MHM,NGR,LPL",
		width: 3,
		height: 3,
		ingredients: {
			"M": { type: "item", code: "game:metalplate-*", allowedVariants: ["iron", "meteoriciron", "steel"] },
			"R": { type: "item", code: "game:rod-*", allowedVariants: ["iron", "meteoriciron", "steel"], quantity: 2 },
			"G": { type: "item", code: "seraphhorizons:gear-steel", quantity: 2 },
			"N": { type: "item", code: "game:metalnailsandstrips-*", allowedVariants: ["iron", "meteoriciron", "steel"], quantity: 4 },
			"L": { type: "block", code: "game:log-placed-oak-ud" },
			"P": { type: "item", code: "game:plank-oak" },
			"H": { type: "item", code: "game:hammer-*", isTool: true }
		},
		output: { type: "block", code: "seraphhorizons:drawbench-frame-north" }
	}
]
