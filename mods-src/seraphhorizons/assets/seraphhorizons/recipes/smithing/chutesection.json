// seraphhorizons' UnifiedPipes switch (README.md "Unified pipes"): a lead chute section, forged on the
// anvil from one ingot exactly as the game forges its copper one (recipes/smithing/chutesection.json
// in the game: a square tube, two layers). Lead and copper sections soldered in pairs make pipe
// (grid/unifiedpipes.json). Marked disabled by UnifiedPipesSystem with the switch off.
[
  {
    "code": "chutesection-{metal}",
    "ingredient": { "type": "item", "code": "game:ingot-*", "name": "metal", "allowedVariants": ["lead"] },
    "pattern": [
      [
        "#####",
        "#___#",
        "#___#",
        "#___#",
        "#####"
      ],
      [
        "#####",
        "#___#",
        "#___#",
        "#___#",
        "#####"
      ]
    ],
    "name": "chutesection",
    "output": { "type": "item", "code": "game:chutesection-{metal}" }
  }
]
