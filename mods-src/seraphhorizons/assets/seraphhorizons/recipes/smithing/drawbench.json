// The draw bench's dies (DrawBench/, README "Draw bench"), each from two ingots of its metal (80
// voxels, over one ingot's 42: two thick 7 x 7 rings with the bore through the middle and a stepped
// shoulder on top, the die's bell). Named drawdie, not plate or blistersteel, the only names the
// game's helve hammer works (ItemWorkItem.GetHelveWorkableMode), so they are smithed by hand. Iron
// ingots make an iron die, steel ingots (from any route, blister steel included) a steel one.
// The server disables them with DrawBench off.
[
	{
		ingredient: { type: "item", code: "game:ingot-*", name: "metal", allowedVariants: ["iron", "steel"] },
		name: "drawdie",
		code: "drawdie-{metal}",
		pattern: [
			[
				"__###__",
				"_#####_",
				"###_###",
				"##___##",
				"###_###",
				"_#####_",
				"__###__"
			],
			[
				"__###__",
				"_#####_",
				"###_###",
				"##___##",
				"###_###",
				"_#####_",
				"__###__"
			],
			[
				"_______",
				"__###__",
				"_##_##_",
				"_#___#_",
				"_##_##_",
				"__###__",
				"_______"
			]
		],
		output: { type: "item", code: "seraphhorizons:drawdie-{metal}" }
	}
]
