// Gear blank molds, raw (#479, GearBlanks; README "Stainless gear blanks"): clay-formed
// (recipes/clayforming/gearblankmold*.json) and fired like the game's tool molds, in a pit kiln
// (ground stored, combustibleProps) or a beehive kiln (beehivekiln), into gearblankmold-fired.json.
{
	code: "toolmold",
	class: "Block",
	behaviors: [
		{ name: "GroundStorable", properties: { layout: "SingleCenter" } },
		{ name: "Unplaceable" },
		{ name: "RightClickPickup" }
	],
	variantgroups: [
		{ code: "color", states: ["blue", "red", "fire"] },
		{ code: "materialtype", states: ["raw"] },
		{ code: "tooltype", states: ["gearblank", "largegearblank"] }
	],
	shape: { base: "seraphhorizons:block/clay/mold/{tooltype}" },
	textures: { all: { base: "game:block/clay/{color}clay" } },
	attributes: {
		reinforcable: true,
		shelvableByType: {
			"*-largegearblank": "SingleCenter",
			"*": false
		},
		handbook: {
			groupBy: ["toolmold-*-{materialtype}-{tooltype}"],
			extraSections: [{ title: "seraphhorizons:gearreclamation-section-title", text: "seraphhorizons:gearreclamation-section-text" }]
		},
		onTongTransform: {
			translation: { x: -0.9, y: -1.5, z: -0.6 },
			rotation: { x: 117, y: 0, z: 0 },
			scale: 0.74
		},
		onMetalTongTransform: {
			translation: { x: -2.1, y: -0.19, z: -1 },
			rotation: { x: 180, y: 7, z: 4 },
			origin: { x: 0.5, y: 0, z: 0.5 },
			scale: 0.55
		}
	},
	attributesByType: {
		"toolmold-red-raw-*": {
			beehivekiln: {
				"0": { type: "block", code: "seraphhorizons:toolmold-tan-fired-{tooltype}" },
				"1": { type: "block", code: "seraphhorizons:toolmold-orange-fired-{tooltype}" },
				"2": { type: "block", code: "seraphhorizons:toolmold-red-fired-{tooltype}" },
				"3": { type: "block", code: "seraphhorizons:toolmold-brown-fired-{tooltype}" }
			}
		},
		"toolmold-blue-raw-*": {
			beehivekiln: {
				"0": { type: "block", code: "seraphhorizons:toolmold-cream-fired-{tooltype}" },
				"1": { type: "block", code: "seraphhorizons:toolmold-gray-fired-{tooltype}" },
				"2": { type: "block", code: "seraphhorizons:toolmold-black-fired-{tooltype}" },
				"3": { type: "block", code: "seraphhorizons:toolmold-black-fired-{tooltype}" }
			}
		},
		"toolmold-fire-raw-*": {
			beehivekiln: {
				"0": { type: "block", code: "seraphhorizons:toolmold-fire-fired-{tooltype}" },
				"1": { type: "block", code: "seraphhorizons:toolmold-fire-fired-{tooltype}" },
				"2": { type: "block", code: "seraphhorizons:toolmold-fire-fired-{tooltype}" },
				"3": { type: "block", code: "seraphhorizons:toolmold-fire-fired-{tooltype}" }
			}
		}
	},
	combustiblePropsByType: {
		"toolmold-fire-raw-*": {
			meltingPoint: 650,
			meltingDuration: 45,
			smeltedRatio: 1,
			smeltingType: "fire",
			smeltedStack: { type: "block", code: "seraphhorizons:toolmold-fire-fired-{tooltype}" },
			requiresContainer: false
		},
		"toolmold-blue-raw-*": {
			meltingPoint: 650,
			meltingDuration: 45,
			smeltedRatio: 1,
			smeltingType: "fire",
			smeltedStack: { type: "block", code: "seraphhorizons:toolmold-blue-fired-{tooltype}" },
			requiresContainer: false
		},
		"toolmold-red-raw-*": {
			meltingPoint: 650,
			meltingDuration: 45,
			smeltedRatio: 1,
			smeltingType: "fire",
			smeltedStack: { type: "block", code: "seraphhorizons:toolmold-earthyorange-fired-{tooltype}" },
			requiresContainer: false
		}
	},
	blockmaterial: "Ceramic",
	creativeinventory: { "general": ["*"], "construction": ["*"] },
	replaceable: 700,
	resistance: 1.5,
	maxStackSize: 8,
	lightAbsorption: 0,
	sounds: {
		walk: "game:walk/stone"
