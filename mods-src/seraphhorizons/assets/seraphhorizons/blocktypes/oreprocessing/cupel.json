	},
	behaviors: [
		{ name: "GroundStorable", properties: { layout: "Quadrants", placeRemoveSound: "game:sounds/player/build", collisionBox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.125, z2: 1 } } },
		{ name: "Unplaceable" },
		{ name: "RightClickPickup" }
	],
	variantgroups: [
