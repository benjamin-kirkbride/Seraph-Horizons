// The clay liquation pan (OreProcessing, #724; README "Liquation"): formed from any clay
// (recipes/clayforming/liquationpan.json) and fired like the game's crucible in a pit kiln or a beehive
// kiln; then a smelting container (Ore/Processing/BlockLiquationPan.cs) in a firepit, through its four
// cooking slots, or in crucibulum's forge. Done, it is a pan of molten tin (BlockLiquationPanSmelted.cs,
// the game's smelted crucible class, poured into molds), never set on the ground since the stack holds
// the lead left in it; emptied, a pan with lead residue (BlockLiquationResidue.cs), knocked out with a
// hammer in the grid into the pan and lead bits. The pan is reused. The shape is the game's clay bowl (its
// contents face the tin or the lead).
// Marked disabled with the switch off.
{
	code: "liquationpan",
	classByType: {
		"liquationpan-raw": "Block",
		"liquationpan-fired": "seraphhorizons.BlockLiquationPan",
		"liquationpan-smelted": "seraphhorizons.BlockLiquationPanSmelted",
		"liquationpan-residue": "seraphhorizons.BlockLiquationResidue"
	},
	behaviorsByType: {
		"liquationpan-smelted": [
			{ name: "Unplaceable" }
