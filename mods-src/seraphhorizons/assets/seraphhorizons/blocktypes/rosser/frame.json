{
	code: "rosser",
	class: "seraphhorizons.Rosser",
	entityClass: "seraphhorizons.Rosser",
	// No HorizontalOrientable: BlockRosser.TryPlaceBlock picks the side so the rosser extends away
	// from the player (Machines/Core/Footprint.cs, PlacedFacing), as the bucking mill does. The
	// shape is turned as the footprint is (Footprint.RotateY).
	variantgroups: [
		{ code: "type", states: [ "frame" ] },
		{ code: "side", loadFromProperties: "abstract/horizontalorientation" }
	],
	shapeByType: {
		"*-north": { base: "seraphhorizons:block/rosser_frame", rotateY: 180 },
		"*-east":  { base: "seraphhorizons:block/rosser_frame", rotateY: 90 },
		"*-south": { base: "seraphhorizons:block/rosser_frame", rotateY: 0 },
		"*-west":  { base: "seraphhorizons:block/rosser_frame", rotateY: 270 }
	},
	// Every texture code of rosser.json: the renderer draws the moving parts with this block's
	// textures. The drip's pipes wear Pipes and Power Expanded's pipe textures as UnifiedPipes gives
	// its copper and lead pipes (patches/unifiedpipes-ppex.json), and their joints the solder of
	// UnifiedPipes' soldered pipes (Pipes/tools/solderedpipe.py); the renderer draws the fitted metal's.
	textures: {
		"oak":        { base: "game:block/wood/debarked/oak" },
		"metal":      { base: "game:block/metal/plate/iron" },
		"pipecopper": { base: "game:block/metal/sheet-plain/copper4" },
		"pipelead":   { base: "game:block/metal/sheet-plain/lead4" },
		"solder":     { base: "game:block/metal/ingot/leadsolder" }
	},
	attributes: {
		handbook: {
			extraSections: [
				{ title: "seraphhorizons:rosser-handbook-assembly-title", text: "seraphhorizons:rosser-handbook-assembly-text" },
				{ title: "seraphhorizons:rosser-handbook-power-title", text: "seraphhorizons:rosser-handbook-power-text" },
				{ title: "seraphhorizons:rosser-handbook-trunks-title", text: "seraphhorizons:rosser-handbook-trunks-text" },
				{ title: "seraphhorizons:rosser-handbook-yield-title", text: "seraphhorizons:rosser-handbook-yield-text" }
			]
		}
	},
	drops: [ { type: "block", code: "seraphhorizons:rosser-frame-north" } ],
	sideopaque: { all: false },
	sidesolid: { all: false },
	lightAbsorption: 0,
	creativeinventory: { "general": ["*-north"], "mechanics": ["*-north"] },
	blockmaterial: "Wood",
	heldTpIdleAnimation: "holdbothhandslarge",
	heldRightReadyAnimation: "heldblockready",
	heldTpUseAnimation: "twohandplaceblock",
	// The shape fills the rosser's whole 16×4×5 footprint (native x -15..1, z -2..3 about the
	// controller at the east end; its mesh x 0.13..15.63, y 0..4, z -2..3 once the -north item form
	// turns it 180°), so the item forms turn about the mesh's middle (7.88, 2, 0.5) and are scaled
	// well down. Held (first and third person alike) the game leaves the origin where it is rather
	// than on the hand, so the translation brings the middle back to vanilla's two-handed crate's
	// spot by the hand, (0.01, 0.14, 0.18): translation = (that spot - origin) / scale
	// (tests/HeldTransformTests.cs).
	tpHandTransform: {
		translation: { x: -131.17, y: -31, z: -5.33 },
		rotation: { x: 6, y: 16, z: -77 },
		origin: { x: 7.88, y: 2, z: 0.5 },
		scale: 0.06
	},
	guiTransform: {
		rotation: { x: -22.6, y: -45.3, z: 0 },
		origin: { x: 7.88, y: 2, z: 0.5 },
		scale: 0.11
	},
	groundTransform: {
		origin: { x: 7.88, y: 0, z: 0.5 },
		scale: 0.24
	},
	maxStackSize: 1,
	resistance: 3.5,
	sounds: {
		"place": "game:block/planks",
		"walk": "game:walk/wood",
		"hit": "game:block/planks",
		"break": "game:block/planks"
	},
	collisionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 1, z2: 1 },
	selectionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 1, z2: 1 }
}
