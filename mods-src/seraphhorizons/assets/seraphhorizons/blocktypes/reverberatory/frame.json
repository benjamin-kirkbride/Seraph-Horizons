// The reverberatory roaster's frame (ReverberatoryRoaster/, README "Ore processing: the reverberatory roaster"; #736):
// the angle-iron box frame of a mechanical reverberatory roaster, its controller the middle of the fire end at ground
// level (the ash mouth's and the fire door's cell). The shared ore machine block (Machines/Game/OreMachineBlocks.cs);
// its stages are fitted by right-click (config/builds/reverberatory.json), and the bed, the fire, the damper's place
// and the cap are drawn by its state (extraRequires, ReverberatoryRoaster/Core/ReverberatoryRig.cs). The server
// disables it with ReverberatoryRoaster or OreProcessing off.
{
	code: "reverberatory",
	class: "seraphhorizons.OreMachine",
	entityClass: "seraphhorizons.Reverberatory",
	// No HorizontalOrientable: BlockOreMachine.TryPlaceBlock picks the side so the fire end faces the player and
	// the furnace runs away from them.
	variantgroups: [
		{ code: "side", loadFromProperties: "abstract/horizontalorientation" }
	],
	shapeByType: {
		"*-north": { base: "seraphhorizons:block/reverberatory_frame", rotateY: 180 },
		"*-east":  { base: "seraphhorizons:block/reverberatory_frame", rotateY: 90 },
		"*-south": { base: "seraphhorizons:block/reverberatory_frame", rotateY: 0 },
		"*-west":  { base: "seraphhorizons:block/reverberatory_frame", rotateY: 270 }
	},
	// Every texture of the frame's shape and of the furnace's parts (reverberatory.json), which the renderer draws
	// with this block's textures; the brickwork's brick is set to the furnace's own brick type.
	textures: {
		"iron":       { base: "game:block/metal/plate/iron" },
		"brick":      { base: "game:block/clay/brick/four/running/cream1", blendedOverlays: [ { base: "game:block/clay/brick/four/running/red1" } ] },
		"lining":     { base: "game:block/clay/refractory/tier3/front1" },
		"oak":        { base: "game:block/wood/debarked/oak" },
		"ore":        { base: "game:block/pile/oldore" },
		"coal":       { base: "game:block/coal/bituminous" },
		"ember":      { base: "game:block/coal/ember" },
		"chute":      { base: "game:block/metal/sheet/copper1" },
		"pipecopper": { base: "game:block/metal/sheet-plain/copper4" },
		"pipelead":   { base: "game:block/metal/sheet-plain/lead4" },
		"solder":     { base: "game:block/metal/ingot/leadsolder" }
	},
	attributes: {
		oreMachine: {
			machine: "reverberatory",
			extraRequires: ["charge", "fire", "outletcap"]
		},
		handbook: {
			extraSections: [
				{ title: "seraphhorizons:reverberatory-handbook-card-title", text: "seraphhorizons:reverberatory-handbook-card-text" },
				{ title: "seraphhorizons:reverberatory-handbook-build-title", text: "seraphhorizons:reverberatory-handbook-build-text" },
				{ title: "seraphhorizons:reverberatory-handbook-work-title", text: "seraphhorizons:reverberatory-handbook-work-text" },
				{ title: "seraphhorizons:reverberatory-handbook-fire-title", text: "seraphhorizons:reverberatory-handbook-fire-text" },
				{ title: "seraphhorizons:reverberatory-handbook-water-title", text: "seraphhorizons:reverberatory-handbook-water-text" }
			]
		}
	},
	drops: [ { type: "block", code: "seraphhorizons:reverberatory-north" } ],
	sideopaque: { all: false },
	sidesolid: { all: false },
	lightAbsorption: 0,
	creativeinventory: { "general": ["*-north"], "mechanics": ["*-north"] },
	blockmaterial: "Stone",
	heldTpIdleAnimation: "holdbothhandslarge",
	heldRightReadyAnimation: "heldblockready",
	heldTpUseAnimation: "twohandplaceblock",
	// The frame fills 3 x 2 x 5 blocks about the controller (native x -1..2, z 0..5); the -north item form turns it
	// 180°, so the item forms turn about the mesh's middle.
	tpHandTransform: {
		translation: { x: -3.33, y: -5.73, z: 11.2 },
		rotation: { x: 6, y: 16, z: -77 },
		origin: { x: 0.5, y: 1, z: -1.5 },
		scale: 0.15
	},
	guiTransform: {
		rotation: { x: -22.6, y: -45.3, z: 0 },
		origin: { x: 0.5, y: 1, z: -1.5 },
		scale: 0.3
	},
	groundTransform: {
		origin: { x: 0.5, y: 0, z: -1.5 },
		scale: 0.4
	},
	maxStackSize: 1,
	resistance: 3.5,
	sounds: {
		"place": "game:block/rock-hit-pickaxe",
		"walk": "game:walk/stone",
		"hit": "game:block/rock-hit-pickaxe",
		"break": "game:block/rock-break-pickaxe"
	},
	collisionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 1, z2: 1 },
	selectionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 1, z2: 1 }
}
