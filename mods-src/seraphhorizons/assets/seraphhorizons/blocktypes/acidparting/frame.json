// The acid parting vessel's frame (AcidParting/, README "Ore processing: the acid parting vessel"; #931): the angle-iron
// frame of a vessel in a sand bath over a small fire, under a hood, its controller the front cell at ground level (the
// fire door's and the ash mouth's). The shared ore machine block (Machines/Game/OreMachineBlocks.cs); its stages are
// fitted by right-click (config/builds/acidparting.json), and the vessel's contents are drawn by its state
// (extraRequires, AcidParting/Core/AcidPartingRig.cs). The server disables it with AcidParting or OreProcessing off.
{
	code: "acidparting",
	class: "seraphhorizons.Machine",
	entityClass: "seraphhorizons.AcidParting",
	// No HorizontalOrientable: BlockMachine.TryPlaceBlock picks the side so the hood's open front faces
	// the player.
	variantgroups: [
		{ code: "side", loadFromProperties: "abstract/horizontalorientation" }
	],
	shapeByType: {
		"*-north": { base: "seraphhorizons:block/acidparting_frame", rotateY: 180 },
		"*-east":  { base: "seraphhorizons:block/acidparting_frame", rotateY: 90 },
		"*-south": { base: "seraphhorizons:block/acidparting_frame", rotateY: 0 },
		"*-west":  { base: "seraphhorizons:block/acidparting_frame", rotateY: 270 }
	},
	// Every texture of the frame's shape and of the vessel's parts (acidparting.json), which the renderer
	// draws with this block's textures; the brickwork's brick is set to the vessel's own brick type.
	textures: {
		"iron":     { base: "game:block/metal/plate/iron" },
		"brick":    { base: "game:block/clay/brick/four/running/red1" },
		"lining":   { base: "game:block/clay/refractory/tier3/front1" },
		"sand":     { base: "game:block/stone/sand/sandstone" },
		"ceramic":  { base: "game:block/clay/hardened/blue" },
		"fuel":     { base: "game:block/coal/charcoal" },
		"ember":    { base: "game:block/coal/ember" },
		"dore":     { base: "game:block/metal/ingot/electrum" },
		"gold":     { base: "game:block/metal/ingot/gold" },
		"acid":     { base: "game:block/liquid/brine" },
		"solution": { base: "game:block/liquid/dye/woad" },
		"water":    { base: "game:block/liquid/waterportion" },
		"oak":      { base: "game:block/wood/planks/oak1" },
		"lead":     { base: "game:block/metal/sheet-plain/lead4" },
		"copper":   { base: "game:block/metal/plate/copper" },
		"silver":   { base: "game:block/metal/ingot/silver" }
	},
	attributes: {
		machine: {
			machine: "acidparting",
			extraRequires: [
				"damperopen", "damperhalf", "dampershut", "fuel", "fire",
				"charge", "acid", "solution", "gold", "wash", "copper", "liquor", "silver", "outletcap"
			]
		},
		handbook: {
			extraSections: [
				{ title: "seraphhorizons:acidparting-handbook-card-title", text: "seraphhorizons:acidparting-handbook-card-text" },
				{ title: "seraphhorizons:acidparting-handbook-build-title", text: "seraphhorizons:acidparting-handbook-build-text" },
				{ title: "seraphhorizons:acidparting-handbook-work-title", text: "seraphhorizons:acidparting-handbook-work-text" },
				{ title: "seraphhorizons:acidparting-handbook-fire-title", text: "seraphhorizons:acidparting-handbook-fire-text" }
			]
		}
	},
	drops: [ { type: "block", code: "seraphhorizons:acidparting-north" } ],
	sideopaque: { all: false },
	sidesolid: { all: false },
	lightAbsorption: 0,
	creativeinventory: { "general": ["*-north"], "mechanics": ["*-north"] },
	blockmaterial: "Stone",
	heldTpIdleAnimation: "holdbothhandslarge",
	heldRightReadyAnimation: "heldblockready",
	heldTpUseAnimation: "twohandplaceblock",
	// The frame fills 1 x 2 x 2 blocks from the controller (native x 0..1, z 0..2); the -north item form turns
	// it 180°, so the item forms turn about the mesh's middle (0.5, 1, 0).
	tpHandTransform: {
		translation: { x: -2, y: -3.44, z: 0.72 },
		rotation: { x: 6, y: 16, z: -77 },
		origin: { x: 0.5, y: 1, z: 0 },
		scale: 0.25
	},
	guiTransform: {
		rotation: { x: -22.6, y: -45.3, z: 0 },
		origin: { x: 0.5, y: 1, z: 0 },
		scale: 0.5
	},
	groundTransform: {
		origin: { x: 0.5, y: 0, z: 0 },
		scale: 0.7
	},
	maxStackSize: 1,
	resistance: 3.5,
	sounds: {
		"place": "game:block/rock-hit-pickaxe",
		"walk": "game:walk/stone",
		"hit": "game:block/rock-hit-pickaxe",
		"break": "game:block/rock-break-pickaxe"
	},
	collisionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 1, z2: 1 },
	selectionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 1, z2: 1 }
}
