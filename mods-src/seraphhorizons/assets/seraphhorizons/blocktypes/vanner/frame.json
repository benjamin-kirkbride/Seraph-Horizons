// The vanner's frame (Vanner/, README "Vanner"; #923): the controller cell of a Frue vanner, the front west
// cell under the head of its belt, nearest the player who placed it; the vanner runs away from them, three
// blocks long and two wide (the countershaft on the east). The shared ore machine block
// (Machines/Game/OreMachineBlocks.cs); its stages are fitted by right-click (config/builds/vanner.json).
// The server disables it with Vanner or OreProcessing off.
{
	code: "vanner",
	class: "seraphhorizons.Machine",
	entityClass: "seraphhorizons.Vanner",
	// No HorizontalOrientable: BlockMachine.TryPlaceBlock picks the side so the vanner runs away from
	// the player, the head of its belt (the controller) nearest them.
	variantgroups: [
		{ code: "side", loadFromProperties: "abstract/horizontalorientation" }
	],
	shapeByType: {
		"*-north": { base: "seraphhorizons:block/vanner_frame", rotateY: 180 },
		"*-east":  { base: "seraphhorizons:block/vanner_frame", rotateY: 90 },
		"*-south": { base: "seraphhorizons:block/vanner_frame", rotateY: 0 },
		"*-west":  { base: "seraphhorizons:block/vanner_frame", rotateY: 270 }
	},
	// Every texture of the frame's shape and of the stages' parts (vanner.json), which the renderer draws
	// with this block's textures.
	textures: {
		"oak":        { base: "game:block/wood/debarked/oak" },
		"planks":     { base: "game:block/wood/planks/oak1" },
		"iron":       { base: "game:block/metal/plate/iron" },
		"steel":      { base: "game:block/metal/sheet-plain/steel1" },
		"leather":    { base: "game:block/leather/plain" },
		"lacing":     { base: "game:block/leather/aged1" },
		"chute":      { base: "game:block/metal/sheet/copper1" },
		"pipecopper": { base: "game:block/metal/sheet-plain/copper4" },
		"pipelead":   { base: "game:block/metal/sheet-plain/lead4" },
		"solder":     { base: "game:block/metal/ingot/leadsolder" }
	},
	attributes: {
		machine: { machine: "vanner" },
		handbook: {
			extraSections: [
				{ title: "seraphhorizons:vanner-handbook-card-title", text: "seraphhorizons:vanner-handbook-card-text" },
				{ title: "seraphhorizons:vanner-handbook-build-title", text: "seraphhorizons:vanner-handbook-build-text" },
				{ title: "seraphhorizons:vanner-handbook-work-title", text: "seraphhorizons:vanner-handbook-work-text" },
				{ title: "seraphhorizons:vanner-handbook-water-title", text: "seraphhorizons:vanner-handbook-water-text" },
				{ title: "seraphhorizons:vanner-handbook-tailings-title", text: "seraphhorizons:vanner-handbook-tailings-text" }
			]
		}
	},
	drops: [ { type: "block", code: "seraphhorizons:vanner-north" } ],
	sideopaque: { all: false },
	sidesolid: { all: false },
	lightAbsorption: 0,
	creativeinventory: { "general": ["*-north"], "mechanics": ["*-north"] },
	blockmaterial: "Wood",
	heldTpIdleAnimation: "holdbothhandslarge",
	heldRightReadyAnimation: "heldblockready",
	heldTpUseAnimation: "twohandplaceblock",
	// The frame fills 2 x 1 x 3 blocks from the controller (native x 0..2, z 0..3); the -north item form
	// turns it 180°, so the item forms turn about its mesh middle (0.19, 0.38, -0.43).
	tpHandTransform: {
		translation: { x: -0.68, y: -0.86, z: 2.18 },
		rotation: { x: 6, y: 16, z: -77 },
		origin: { x: 0.19, y: 0.38, z: -0.43 },
		scale: 0.28
	},
	guiTransform: {
		rotation: { x: -22.6, y: -45.3, z: 0 },
		origin: { x: 0.19, y: 0.38, z: -0.43 },
		scale: 0.55
	},
	groundTransform: {
		origin: { x: 0.19, y: 0, z: -0.43 },
		scale: 1
	},
	maxStackSize: 1,
	resistance: 3,
	sounds: {
		"place": "game:block/planks",
		"walk": "game:walk/wood",
		"hit": "game:block/planks",
		"break": "game:block/planks"
	},
	collisionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 1, z2: 1 },
	selectionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 1, z2: 1 }
}
