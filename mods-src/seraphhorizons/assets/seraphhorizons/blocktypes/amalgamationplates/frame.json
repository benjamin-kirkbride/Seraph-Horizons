// The amalgamation plates' frame (AmalgamationPlates/, README "Ore processing: the amalgamation plates"; #917):
// the head cell of a plate table three blocks long, nearest the player who placed it; the plates fall away
// from them. The shared ore machine block (Machines/Game/OreMachineBlocks.cs); its stages are fitted by
// right-click (config/builds/amalgamationplates.json). The dressing and the amalgam are the machine's own
// parts, drawn by its state. The server disables it with AmalgamationPlates or OreProcessing off.
{
	code: "amalgamationplates",
	class: "seraphhorizons.Machine",
	entityClass: "seraphhorizons.AmalgamationPlates",
	// No HorizontalOrientable: BlockMachine.TryPlaceBlock picks the side so the plates fall away from
	// the player, the head (the controller) nearest them.
	variantgroups: [
		{ code: "side", loadFromProperties: "abstract/horizontalorientation" }
	],
	shapeByType: {
		"*-north": { base: "seraphhorizons:block/amalgamationplates_frame", rotateY: 180 },
		"*-east":  { base: "seraphhorizons:block/amalgamationplates_frame", rotateY: 90 },
		"*-south": { base: "seraphhorizons:block/amalgamationplates_frame", rotateY: 0 },
		"*-west":  { base: "seraphhorizons:block/amalgamationplates_frame", rotateY: 270 }
	},
	// Every texture of the frame's shape and of the parts (amalgamationplates.json), which the renderer
	// draws with this block's textures.
	textures: {
		"oak":        { base: "game:block/wood/debarked/oak" },
		"planks":     { base: "game:block/wood/planks/oak1" },
		"copper":     { base: "game:block/metal/sheet-plain/copper1" },
		"mercury":    { base: "game:block/stone/rock/andesite2" },
		"amalgam":    { base: "game:block/metal/ingot/leadsolder" },
		"iron":       { base: "game:block/metal/plate/iron" },
		"chute":      { base: "game:block/metal/sheet/copper1" },
		"pipecopper": { base: "game:block/metal/sheet-plain/copper4" },
		"pipelead":   { base: "game:block/metal/sheet-plain/lead4" },
		"solder":     { base: "game:block/metal/ingot/leadsolder" }
	},
	attributes: {
		machine: { machine: "amalgamationplates", extraRequires: ["dressing", "amalgam1", "amalgam2", "amalgam3"] },
		handbook: {
			extraSections: [
				{ title: "seraphhorizons:amalgamationplates-handbook-card-title", text: "seraphhorizons:amalgamationplates-handbook-card-text" },
				{ title: "seraphhorizons:amalgamationplates-handbook-build-title", text: "seraphhorizons:amalgamationplates-handbook-build-text" },
				{ title: "seraphhorizons:amalgamationplates-handbook-work-title", text: "seraphhorizons:amalgamationplates-handbook-work-text" },
				{ title: "seraphhorizons:amalgamationplates-handbook-mercury-title", text: "seraphhorizons:amalgamationplates-handbook-mercury-text" }
			]
		}
	},
	drops: [ { type: "block", code: "seraphhorizons:amalgamationplates-north" } ],
	sideopaque: { all: false },
	sidesolid: { all: false },
	lightAbsorption: 0,
	creativeinventory: { "general": ["*-north"], "mechanics": ["*-north"] },
	blockmaterial: "Wood",
	heldTpIdleAnimation: "holdbothhandslarge",
	heldRightReadyAnimation: "heldblockready",
	heldTpUseAnimation: "twohandplaceblock",
	// The frame runs three blocks along native z from the controller (z 0..3); the -north item form turns
	// it 180°, its mesh z -2..1, so the item forms turn about its middle (0.5, 0.5, -0.5).
	tpHandTransform: {
		translation: { x: -1.4, y: -1.2, z: 2.4 },
		rotation: { x: 6, y: 16, z: -77 },
		origin: { x: 0.5, y: 0.5, z: -0.5 },
		scale: 0.3
	},
	guiTransform: {
		rotation: { x: -22.6, y: -45.3, z: 0 },
		origin: { x: 0.5, y: 0.5, z: -0.5 },
		scale: 0.55
	},
	groundTransform: {
		origin: { x: 0.5, y: 0, z: -0.5 },
		scale: 1
	},
	maxStackSize: 1,
	resistance: 3,
	sounds: {
		"place": "game:block/planks",
		"walk": "game:walk/wood",
		"hit": "game:block/planks",
		"break": "game:block/planks"
	},
	collisionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 1, z2: 1 },
	selectionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 1, z2: 1 }
}
