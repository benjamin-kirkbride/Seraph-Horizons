		{ code: "type", states: [ "frame" ] },
		{ code: "side", loadFromProperties: "abstract/horizontalorientation" }
	],
	shapeByType: {
		"*-north": { base: "seraphhorizons:block/buckingmill_frame", rotateY: 180 },
		"*-east":  { base: "seraphhorizons:block/buckingmill_frame", rotateY: 90 },
		"*-south": { base: "seraphhorizons:block/buckingmill_frame", rotateY: 0 },
		"*-west":  { base: "seraphhorizons:block/buckingmill_frame", rotateY: 270 }
	},
	textures: {
		"oak":   { base: "game:block/wood/debarked/oak" },
		"metal": { base: "game:block/metal/plate/iron" },
		"rope":  { base: "game:item/resource/rope" }
	},
	attributes: {
		handbook: {
			extraSections: [
				{ title: "seraphhorizons:buckingmill-handbook-assembly-title", text: "seraphhorizons:buckingmill-handbook-assembly-text" },
				{ title: "seraphhorizons:buckingmill-handbook-power-title", text: "seraphhorizons:buckingmill-handbook-power-text" },
				{ title: "seraphhorizons:buckingmill-handbook-trunks-title", text: "seraphhorizons:buckingmill-handbook-trunks-text" },
				{ title: "seraphhorizons:buckingmill-handbook-yield-title", text: "seraphhorizons:buckingmill-handbook-yield-text" }
			]
		}
