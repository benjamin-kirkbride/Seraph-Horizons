{
	code: "buckingmill",
	class: "seraphhorizons.BuckingMill",
	entityClass: "seraphhorizons.BuckingMill",
	// No HorizontalOrientable: BlockBuckingMill.TryPlaceBlock picks the side so the mill extends
	// away from the player (Machines/Core/Footprint.cs, PlacedFacing).
