// The slitting mill's frame (SlittingMill/, README "Slitting mill"): the controller cell of a 2 x 2 x 2
// slitting mill, the feed table's west half, nearest the player who placed it. The server disables it with
// SlittingMill off.
{
	code: "slittingmill",
	class: "seraphhorizons.Machine",
	entityClass: "seraphhorizons.SlittingMill",
	// No HorizontalOrientable: BlockMachine.TryPlaceBlock picks the side so the mill extends away
	// from the player, the plate's way, as the draw bench does.
	variantgroups: [
		{ code: "type", states: [ "frame" ] },
		{ code: "side", loadFromProperties: "abstract/horizontalorientation" }
	],
	shapeByType: {
		"*-north": { base: "seraphhorizons:block/slittingmill_frame", rotateY: 180 },
		"*-east":  { base: "seraphhorizons:block/slittingmill_frame", rotateY: 90 },
		"*-south": { base: "seraphhorizons:block/slittingmill_frame", rotateY: 0 },
		"*-west":  { base: "seraphhorizons:block/slittingmill_frame", rotateY: 270 }
	},
	// Every texture of the frame's shape and of the moving parts' (slittingmill.json), which the
	// renderer draws with this block's textures; the renderer sets "metal", the work's, to the plate's.
	textures: {
		"oak":         { base: "game:block/wood/debarked/oak" },
		"iron":        { base: "game:block/metal/plate/iron" },
		"steel":       { base: "game:block/metal/sheet-plain/steel1" },
		"brass":       { base: "game:block/metal/sheet/brass1" },
		"cupronickel": { base: "game:block/metal/sheet/cupronickel1" },
		"metal":       { base: "game:block/metal/ingot/iron" }
	},
	attributes: {
		handbook: {
			extraSections: [
				{ title: "seraphhorizons:slittingmill-handbook-assembly-title", text: "seraphhorizons:slittingmill-handbook-assembly-text" },
				{ title: "seraphhorizons:slittingmill-handbook-work-title", text: "seraphhorizons:slittingmill-handbook-work-text" },
				{ title: "seraphhorizons:slittingmill-handbook-oil-title", text: "seraphhorizons:slittingmill-handbook-oil-text" }
			]
		}
	},
	drops: [ { type: "block", code: "seraphhorizons:slittingmill-frame-north" } ],
	sideopaque: { all: false },
	sidesolid: { all: false },
	lightAbsorption: 0,
	creativeinventory: { "general": ["*-north"], "mechanics": ["*-north"] },
	blockmaterial: "Wood",
	heldTpIdleAnimation: "holdbothhandslarge",
	heldRightReadyAnimation: "heldblockready",
	heldTpUseAnimation: "twohandplaceblock",
	// The frame's shape spans the mill's 2 x 2 x 2 footprint (native x 0.5..2, z 0.06..1.97 from the
	// controller; its mesh x -1..0.5, y 0..1.67, z -0.97..0.94 once the -north item form turns it 180°), so
	// the item forms turn about the mesh's middle (-0.25, 0.84, 0). Held, the translation brings the middle
	// back to vanilla's two-handed crate's spot by the hand, (0.01, 0.14, 0.18): translation = (that spot -
	// origin) / scale (tests/HeldTransformTests.cs).
	tpHandTransform: {
		translation: { x: 0.65, y: -1.75, z: 0.45 },
		rotation: { x: 6, y: 16, z: -77 },
		origin: { x: -0.25, y: 0.84, z: 0 },
		scale: 0.4
	},
	guiTransform: {
		rotation: { x: -22.6, y: -45.3, z: 0 },
		origin: { x: -0.25, y: 0.84, z: 0 },
		scale: 0.62
	},
	groundTransform: {
		origin: { x: -0.25, y: 0, z: 0 },
		scale: 1.3
	},
	maxStackSize: 1,
	resistance: 3.5,
	sounds: {
		"place": "game:block/planks",
		"walk": "game:walk/wood",
		"hit": "game:block/planks",
		"break": "game:block/planks"
	},
	collisionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 1, z2: 1 },
	selectionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 1, z2: 1 }
}
