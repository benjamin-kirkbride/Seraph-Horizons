// The Parkes kettle's frame (ParkesKettle/, README "Ore processing: the Parkes kettle"; #927): the iron frame of a
// desilverizing kettle's setting, its controller the front middle cell at ground level, the fire's front. The shared
// ore machine block (Machines/Game/OreMachineBlocks.cs); its stages are fitted by right-click
// (config/builds/parkeskettle.json), and the bath, the zinc, the crust, the grate's coal, the damper and the cap are
// drawn by its state (extraRequires, ParkesKettle/Core/ParkesKettleRig.cs). The server disables it with ParkesKettle
// or OreProcessing off.
{
	code: "parkeskettle",
	class: "seraphhorizons.OreMachine",
	entityClass: "seraphhorizons.ParkesKettle",
	// No HorizontalOrientable: BlockOreMachine.TryPlaceBlock picks the side so the kettle's front (its fire door
	// and ash mouth) faces the player.
	variantgroups: [
		{ code: "side", loadFromProperties: "abstract/horizontalorientation" }
	],
	shapeByType: {
		"*-north": { base: "seraphhorizons:block/parkeskettle_frame", rotateY: 180 },
		"*-east":  { base: "seraphhorizons:block/parkeskettle_frame", rotateY: 90 },
		"*-south": { base: "seraphhorizons:block/parkeskettle_frame", rotateY: 0 },
		"*-west":  { base: "seraphhorizons:block/parkeskettle_frame", rotateY: 270 }
	},
	// Every texture of the frame's shape and of the kettle's parts (parkeskettle.json), which the renderer draws
	// with this block's textures; the brickwork's brick is set to the setting's own brick type.
	textures: {
		"brick":  { base: "game:block/clay/brick/four/running/cream1", blendedOverlays: [ { base: "game:block/clay/brick/four/running/red1" } ] },
		"lining": { base: "game:block/clay/refractory/tier3/front1" },
		"iron":   { base: "game:block/metal/plate/iron" },
		"steel":  { base: "game:block/metal/sheet-plain/steel1" },
		"oak":    { base: "game:block/wood/debarked/oak" },
		"lead":   { base: "game:block/metal/ingot/lead" },
		"zinc":   { base: "game:block/metal/ingot/zinc" },
		"crust":  { base: "game:block/metal/ingot/zinc" },
		"fuel":   { base: "game:block/coal/bituminous" },
		"ember":  { base: "game:block/coal/ember" }
	},
	attributes: {
		oreMachine: {
			machine: "parkeskettle",
			extraRequires: [
				"lead1", "lead2", "lead3", "lead4", "zinc", "crust", "fuel1", "fuel2", "fire1", "fire2",
				"damperopen", "damperhalf", "dampershut", "outletcap"
			]
		},
		handbook: {
			extraSections: [
				{ title: "seraphhorizons:parkeskettle-handbook-card-title", text: "seraphhorizons:parkeskettle-handbook-card-text" },
				{ title: "seraphhorizons:parkeskettle-handbook-build-title", text: "seraphhorizons:parkeskettle-handbook-build-text" },
				{ title: "seraphhorizons:parkeskettle-handbook-work-title", text: "seraphhorizons:parkeskettle-handbook-work-text" },
				{ title: "seraphhorizons:parkeskettle-handbook-fire-title", text: "seraphhorizons:parkeskettle-handbook-fire-text" }
			]
		}
	},
	drops: [ { type: "block", code: "seraphhorizons:parkeskettle-north" } ],
	sideopaque: { all: false },
	sidesolid: { all: false },
	lightAbsorption: 0,
	creativeinventory: { "general": ["*-north"], "mechanics": ["*-north"] },
	blockmaterial: "Stone",
	heldTpIdleAnimation: "holdbothhandslarge",
	heldRightReadyAnimation: "heldblockready",
	heldTpUseAnimation: "twohandplaceblock",
	// The frame fills 3 x 2 x 3 blocks about the controller (native x -1..2, z 0..3); the -north item form turns it
	// 180°, so the item forms turn about the mesh's middle; held, the translation brings that middle to the hand
	// (tests/HeldTransformTests.cs).
	tpHandTransform: {
		translation: { x: -2.5, y: -4.3, z: 3.4 },
		rotation: { x: 6, y: 16, z: -77 },
		origin: { x: 0.5, y: 1, z: -0.5 },
		scale: 0.2
	},
	guiTransform: {
		rotation: { x: -22.6, y: -45.3, z: 0 },
		origin: { x: 0.5, y: 1, z: -0.5 },
		scale: 0.4
	},
	groundTransform: {
		origin: { x: 0.5, y: 0, z: -0.5 },
		scale: 0.6
	},
	maxStackSize: 1,
	resistance: 3.5,
	sounds: {
		"place": "game:block/rock-hit-pickaxe",
		"walk": "game:walk/stone",
		"hit": "game:block/rock-hit-pickaxe",
		"break": "game:block/rock-break-pickaxe"
	},
	collisionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 1, z2: 1 },
	selectionbox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 1, z2: 1 }
}
