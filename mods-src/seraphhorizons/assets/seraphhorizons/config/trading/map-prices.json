// Maps and leads at traders (#455, README "Maps and leads", docs/trading.md): read by
// Trading/Maps/Core/MapPrices.cs. Prospectors sell ore maps (one per metal, the nearest unsold
// deposit within oreRadius, at most maxOreOffers); every trader sells a gravel map to the nearest
// unsold field within gravelRadius, and leads to other camps within leadCells camp cells.
// An ore map's price: ore[size class][precision − 1] × metalFactor; the size class is the deposit's
// last measurement, "unsurveyed" until it has one. Prices are before standing's price factor.
{
	"oreRadius": 5000,
	"gravelRadius": 2000,
	"maxOreOffers": 4,
	"leadCells": 3,
	"farLeads": 1,
	"ore": {
		// precision 1 (within 400 m), 2 (within 150 m), 3 (exact)
		"unsurveyed": [8, 14, 22],
		"small":      [5, 9, 14],
		"medium":     [8, 14, 22],
		"large":      [12, 20, 32],
	},
	// Deposits a group sells out of fastest, or that a district hides, cost more.
	"metalFactor": {"copper": 1.0, "tin": 1.3, "zinc": 1.1, "bismuth": 1.0, "lead": 0.9, "nickel": 1.2,
		"iron": 1.4, "silver": 1.6, "gold": 1.8, "platinum": 1.8, "titanium": 1.5, "chromium": 1.5},
	"gravel": 5,
	"leads": {"camp": 2, "prospector": 4, "far": 4, "settlement": 6},
}
