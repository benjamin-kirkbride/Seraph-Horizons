// Maps and leads at traders (#455, README "Maps and leads", docs/trading.md): read by
// Trading/Maps/Core/MapPrices.cs. Prospectors sell ore maps (one per metal, the nearest unsold
// deposit within oreRadius, at most maxOreOffers); every trader sells a gravel map to the nearest
// unsold field within gravelRadius, leads to other camps (campLeads) and, from the tier with
// mapsToTraders, a lead to the nearest settlement ground.
// An ore map's price (Trading/Maps/Core/MapPrices.cs, OrePrice): the ingots in the middle of the
// deposit's size band × the item value of the metal's ingot (game:ingot-<metal>, config/item-values.json)
// × share[precision − 1] (the offer's own precision, drawn by precisionWeights) × scarcity (× underwater for a deposit under water), rounded, at least 1. The size class is the deposit's last
// measurement, "unsurveyed" until it has one; the bands are the bottom, middle and top third of the
// metal's smallIngots..largeIngots (config/ore-sizes.json, DepositSizing), and "unsurveyed" takes the
// medium band's middle. Always the band's middle, never the measured size.
// Ore, gravel and settlement prices are before standing's price factor; camp leads carry their own
// discount instead (campLeads.tiers).
{
	"oreRadius": 5000,
	"gravelRadius": 2000,
	"maxOreOffers": 4,
	// Share of the ingots' worth by precision 1 (rough, within 150 m), 2 (fair, 50 m), 3 (fine, 15 m).
	// A shallow curve: a finer map costs a little more, not several times as much.
	"share": [0.03, 0.04, 0.05],
	// How likely each ore map offer is to be rough, fair or fine (relative weights). The precision is
	// drawn when the offer is shelved (a restock, or its survey landing) and kept until the next
	// restock: the same map for every buyer, whatever their standing (standing still sets the price
	// factor). Three entries, none negative, summing above 0.
	"precisionWeights": [50, 35, 15],
	// Times the price, by metal (1 when not listed): the metals hydrothermal districts hide.
	"scarcity": {"gold": 3, "silver": 3, "nickel": 3, "titanium": 3, "chromium": 3, "platinum": 3},
	// Times the price for a deposit under water: more than half of its ore's columns under more than
	// 2 blocks of water or ice (Ore/Core/DepositWater.cs). Its maps say "underwater".
	"underwater": 0.1,
	"gravel": 5,
	"settlement": 6,
	// Leads to other trader camps, per buyer (Trading/Maps/Core/CampLeads.cs). Distance is in rings
	// of 2,048-block grid cells from the selling trader's cell to the camp's (diagonals adjacent:
	// ring 1 is the eight cells around the trader's own), so a lead's price and reach are known
	// before its camp generates. Per standing tier: how many maps are on offer at once and how many
	// rings out they reach, the nearest camps the buyer lacks (not on their map, no lead carried),
	// the first a prospector if they have none in reach; buying one brings the next-nearest. A
	// stranger (or a tier not listed) gets one map per trader per group, ever, to the nearest camp
	// in reach their group lacks and has not visited: they chain from camp to camp.
	// Price: base × D × R × the tier's discount (in place of standing's price factor), rounded, at
	// least 1, where D = 1 + distanceCurve × ease × ln(1 + ring) and R = 1 + repeatCurve × ease ×
	// ln(1 + maps the group already bought from this trader, never reset).
	// A player's first map is not sold: the spawn mark (SpawnProspectorMark) marks the nearest
	// prospector on their first join (the pity map it replaced was removed).
	"campLeads": {
		"base": 12,
		"distanceCurve": 1.5,
		"repeatCurve": 3,
		"tiers": {
			"stranger": {"maps": 1, "reach": 1, "ease": 1,    "discount": 1},
			"known":    {"maps": 2, "reach": 1, "ease": 0.85, "discount": 0.85},
			"regular":  {"maps": 3, "reach": 2, "ease": 0.7,  "discount": 0.7},
			"trusted":  {"maps": 5, "reach": 3, "ease": 0.6,  "discount": 0.55},
			"partner":  {"maps": 8, "reach": 5, "ease": 0.5,  "discount": 0.4},
		},
	},
}
