<Project Sdk="Microsoft.NET.Sdk">

  <!-- Client and server mod holding the pack's own tweaks (README.md here): gameplay tweaks to
       other mods, and Tidy Variants (TidyVariants/), the creative inventory and handbook variant
       grouping. Built from this repo, uploaded to the ModDB by hand, and pinned in pack.toml like
       any other mod. Atlas scenarios load this build instead of the pinned copy.

       Layout: the top level holds the tweaks to other mods; TidyVariants/Core/ is Tidy Variants'
       game-independent rule engine (BCL only; its unit tests in tests/ are their own project and
       compile those files directly), TidyVariants/Game/ its game-facing code. MapReveal/,
       CreativeModTabs/ and BuckingSawmill/ are laid out the same way; BuckingSawmill/tools/ holds
       that machine's model generator (Python) and is not part of the build. Everything under assets/ ships in the mod as is. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SeraphHorizons</AssemblyName>
    <RootNamespace>SeraphHorizons.Mod</RootNamespace>
    <!-- Keep equal to modinfo.json's version; tools/tests/test_mods_src.py checks it. -->
    <Version>1.0.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Atlas copies a mod folder by its name: a plain bin/Debug would land in the same
         TestMods/Debug as another mods-src mod, and the game loads neither. -->
    <OutputPath>bin/$(Configuration)/seraphhorizons/</OutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The unit tests are their own project (tests/SeraphHorizons.Tests.csproj). -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <Content Remove="tests/**" />
  </ItemGroup>

  <!-- Only the game's own assemblies are referenced, so the mod builds from the game alone
       (mod-release.yml needs nothing else). The tweaked mods are not referenced: each tweak finds
       its targets by name at run time, and one whose mod is missing or changed is skipped with a
       warning. -->
  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Tidy Variants: the creative inventory and handbook dialogs are client types in the game's
         own library and its built-in mods. -->
    <Reference Include="VintagestoryLib">
      <HintPath>$(VINTAGE_STORY)/VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(VINTAGE_STORY)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VINTAGE_STORY)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSCreativeMod">
      <HintPath>$(VINTAGE_STORY)/Mods/VSCreativeMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VINTAGE_STORY)/Lib/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Map Reveal: its network packet, and the block fields of a saved chunk it reads. -->
    <Reference Include="protobuf-net">
      <HintPath>$(VINTAGE_STORY)/Lib/protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Tidy Variants: worldproperties files are the game's lenient JSON (unquoted keys); the game ships this. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VINTAGE_STORY)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Creative mod tabs: the tab strip and button draw with Cairo, and the server sends the tab
         list in a protobuf message; the game ships both. -->
    <Reference Include="cairo-sharp">
      <HintPath>$(VINTAGE_STORY)/Lib/cairo-sharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VINTAGE_STORY)/Lib/protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <None Include="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- In the output folder too, so the build Atlas loads has its lang and config files. -->
    <None Update="assets/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- build/seraphhorizons_<version>.zip, for the ModDB upload: the DLL, modinfo.json and
       CREDITS.md at the top level, as the game loads it, and assets/ with its folders. -->
  <Target Name="ModZip" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_ZipStage>$(IntermediateOutputPath)modzip/</_ZipStage>
      <_ZipOut>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', 'build', 'seraphhorizons_$(Version).zip'))</_ZipOut>
    </PropertyGroup>
    <ItemGroup>
      <_ModAsset Include="assets/**" />
    </ItemGroup>
    <RemoveDir Directories="$(_ZipStage)" />
    <Copy SourceFiles="$(TargetPath);modinfo.json;CREDITS.md" DestinationFolder="$(_ZipStage)" />
    <Copy SourceFiles="@(_ModAsset)" DestinationFiles="@(_ModAsset->'$(_ZipStage)assets/%(RecursiveDir)%(Filename)%(Extension)')" />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_ZipOut)'))" />
    <ZipDirectory SourceDirectory="$(_ZipStage)" DestinationFile="$(_ZipOut)" Overwrite="true" />
    <Message Importance="high" Text="mod zip: $(_ZipOut)" />
  </Target>

</Project>
