<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for Seraph Horizons' game-independent code: Tidy Variants' rule engine
       (../TidyVariants/Core), the tweaks' own (../Core), Map Reveal's sampling, shading and
       wire format (../MapReveal/Core), creative mod tabs' planning (../CreativeModTabs/Core), the
       machines' shared rig maths, footprint and trunk path (../Machines/Core), the bucking
       sawmill's assembly rules and cut arithmetic (../BuckingSawmill/Core), the rosser's
       (../Rosser/Core), the item value table's lookup (../Trading/Values/Core), the ore
       cells' grid, state and vein scaling (../Ore/Core), the traders' grid, regions, lists
       and restock (../Trading/Core), standing (../Trading/Standing/Core) and their economy's
       prices and supply (../Trading/Economy/Core), the schematics' table and grid placement
       (../Trading/Schematics/Core), orders and deliveries (../Trading/Orders/Core,
       ../Trading/Deliveries/Core), the traders' maps and leads (../Trading/Maps/Core), and the
       travelling merchants' inns (../Trading/Visitors/Core), the trade window's view model
       (../Trading/Window/Core), the trunk entities' weights
       and boxes (../TrunkEntities/Core), the draw bench's rules (../DrawBench/Core), the press brake's (../PressBrake/Core), the squaring shear's (../SquaringShear/Core), the mandrel station's (../MandrelStation/Core), the pack version check (../PackCheck/Core) and the NaN motion diagnostics' tracker and report formatting (../NanMotion/Core).
       They compile those files directly and need neither the game nor the pack:
       `dotnet test mods-src/seraphhorizons/tests`.
       Fixtures are trimmed-down real variantgroups from vanilla 1.22.7 and the pack's mods. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="../TidyVariants/Core/**/*.cs" Link="TidyVariants/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../MapReveal/Core/**/*.cs" Link="MapReveal/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../CreativeModTabs/Core/**/*.cs" Link="CreativeModTabs/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Machines/Core/**/*.cs" Link="Machines/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../BuckingSawmill/Core/**/*.cs" Link="BuckingSawmill/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Rosser/Core/**/*.cs" Link="Rosser/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Trading/Values/Core/**/*.cs" Link="Trading/Values/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Item values (#449): the shipped table, so the tests check that it parses. -->
    <None Include="../assets/seraphhorizons/config/item-values.json" Link="item-values.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Rarer battle towers (#519): the shipped rates, so the tests check that they parse. -->
    <None Include="../assets/seraphhorizons/config/battletowers-rates.json" Link="battletowers-rates.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Ore/Core/**/*.cs" Link="Ore/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Trading/Core/**/*.cs" Link="Trading/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Trader standing and companies (#452, #463), and the shipped tiers file. -->
    <Compile Include="../Trading/Standing/Core/**/*.cs" Link="Trading/Standing/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../assets/seraphhorizons/config/standing-tiers.json" Link="standing-tiers.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The trading economy (#450, #451): fit, prices, side budget, supply; and the shipped relations. -->
    <Compile Include="../Trading/Economy/Core/**/*.cs" Link="Trading/Economy/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../assets/seraphhorizons/config/trading/trader-relations.json" Link="trader-relations.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../assets/seraphhorizons/config/trading/list-prices.json" Link="list-prices.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../TrunkEntities/Core/**/*.cs" Link="TrunkEntities/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The bucking sawmill's shipped rig, so the tests check that it parses and is consistent,
         and every part's matrix at a grid of poses, from BuckingSawmill/tools/make_shape.py's
         reference maths. -->
    <None Include="../assets/seraphhorizons/config/buckingmill-rig.json" Link="buckingmill-rig.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="BuckingSawmill/rig-reference.json" Link="buckingmill-rig-reference.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The shared drivers' fixture (Machines/tools/make_fixture.py): a synthetic rig using every
         through-feed driver, with each part's matrix at a grid of poses from the Python reference
         maths. DriverFixtureTests holds Machines/Core to it. -->
    <None Include="Machines/driver-fixture.json" Link="driver-fixture.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The rosser's hand-written test rig, which its gameplay tests read. -->
    <None Include="Rosser/fixtures/rosser-rig-test.json" Link="rosser-rig-test.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The rosser's shipped rig and its reference poses, once they exist. -->
    <None Include="../assets/seraphhorizons/config/rosser-rig.json" Link="rosser-rig.json" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('../assets/seraphhorizons/config/rosser-rig.json')" />
    <None Include="Rosser/rig-reference.json" Link="rosser-rig-reference.json" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('Rosser/rig-reference.json')" />
    <!-- The gear cutter's gameplay rules (#480, #481): parts, the cut, wear, settings and its rig. -->
    <Compile Include="../GearCutter/Core/**/*.cs" Link="GearCutter/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The gear cutter's shipped rig and its reference poses (GearCutter/tools/make_shape.py). -->
    <None Include="../assets/seraphhorizons/config/gearcutter-rig.json" Link="gearcutter-rig.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="GearCutter/rig-reference.json" Link="gearcutter-rig-reference.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The draw bench's gameplay rules: parts, the draw, the renderer's clock, settings and its rig;
         a hand-trimmed test rig; and the shipped rig and its reference poses
         (DrawBench/tools/make_shape.py), once they exist (the rig tests skip until then). -->
    <Compile Include="../DrawBench/Core/**/*.cs" Link="DrawBench/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="DrawBench/fixtures/drawbench-rig-test.json" Link="drawbench-rig-test.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../assets/seraphhorizons/config/drawbench-rig.json" Link="drawbench-rig.json" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('../assets/seraphhorizons/config/drawbench-rig.json')" />
    <None Include="DrawBench/rig-reference.json" Link="drawbench-rig-reference.json" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('DrawBench/rig-reference.json')" />
    <!-- The press brake's gameplay rules: parts, the fold, the renderer's clock, settings and its rig;
         and the shipped rig and its reference poses (PressBrake/tools/make_shape.py), once they exist
         (the rig tests skip until then). -->
    <Compile Include="../PressBrake/Core/**/*.cs" Link="PressBrake/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../assets/seraphhorizons/config/pressbrake-rig.json" Link="pressbrake-rig.json" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('../assets/seraphhorizons/config/pressbrake-rig.json')" />
    <None Include="PressBrake/rig-reference.json" Link="pressbrake-rig-reference.json" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('PressBrake/rig-reference.json')" />
    <!-- The squaring shear's gameplay rules: parts, the cut, the renderer's clock, settings and its rig;
         and the shipped rig and its reference poses (SquaringShear/tools/make_shape.py), once they exist
         (the rig tests skip until then). -->
    <Compile Include="../SquaringShear/Core/**/*.cs" Link="SquaringShear/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../assets/seraphhorizons/config/squaringshear-rig.json" Link="squaringshear-rig.json" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('../assets/seraphhorizons/config/squaringshear-rig.json')" />
    <None Include="SquaringShear/rig-reference.json" Link="squaringshear-rig-reference.json" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('SquaringShear/rig-reference.json')" />
    <!-- The mandrel station's gameplay rules: the mandrel, the forging, the renderer's clock, settings
         and its rig; and the shipped rig and its reference poses (MandrelStation/tools/make_shape.py),
         once they exist (the rig tests skip until then). -->
    <!-- The crucible furnace's rules: pot recipes and charging, the heat model, the row, the pour window. -->
    <Compile Include="../CrucibleFurnace/Core/**/*.cs" Link="CrucibleFurnace/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../MandrelStation/Core/**/*.cs" Link="MandrelStation/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../assets/seraphhorizons/config/mandrelstation-rig.json" Link="mandrelstation-rig.json" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('../assets/seraphhorizons/config/mandrelstation-rig.json')" />
    <None Include="MandrelStation/rig-reference.json" Link="mandrelstation-rig-reference.json" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('MandrelStation/rig-reference.json')" />
    <!-- The handcar's drive, controls and animation timing, and its generated rig, reference poses,
         rider targets and entity type (Handcar/tools/make_shape.py), which the tests hold together. -->
    <Compile Include="../Handcar/Core/**/*.cs" Link="Handcar/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../assets/seraphhorizons/config/handcar-rig.json" Link="handcar-rig.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../assets/seraphhorizons/entities/handcar.json" Link="handcar-entity.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Handcar/rig-reference.json" Link="handcar-rig-reference.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Handcar/rider-reference.json" Link="handcar-rider-reference.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The eleven shipped trade lists and the curation fixture, for ShippedTradeListsTests. -->
    <None Include="../assets/seraphhorizons/config/tradelists/*.json" Link="tradelists/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Trading/fixtures/curation-sources.json" Link="curation-sources.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Schematics (#468, #469): the table, the item type and the lang file it is held to. -->
    <Compile Include="../Trading/Schematics/Core/**/*.cs" Link="Trading/Schematics/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../assets/seraphhorizons/config/schematic-gates.json" Link="schematic-gates.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../assets/seraphhorizons/itemtypes/schematic.json" Link="schematic-itemtype.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../assets/seraphhorizons/lang/en.json" Link="lang-en.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Standing orders and deliveries (#453, #454): generation, premiums, deadlines, state machines. -->
    <Compile Include="../Trading/Orders/Core/**/*.cs" Link="Trading/Orders/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Trading/Deliveries/Core/**/*.cs" Link="Trading/Deliveries/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Maps and leads at traders (#455): offer selection, tier gating, lead targets, and the shipped price table. -->
    <Compile Include="../Trading/Maps/Core/**/*.cs" Link="Trading/Maps/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../assets/seraphhorizons/config/trading/map-prices.json" Link="map-prices.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../assets/seraphhorizons/config/ore-sizes.json" Link="ore-sizes.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Gear reclamation (#474, #475, #477): the roll, flash rust hours, settings, optional
         ingredients; and the shipped item types and recipes held to them. -->
    <Compile Include="../GearReclamation/Core/**/*.cs" Link="GearReclamation/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../assets/seraphhorizons/itemtypes/gear.json" Link="gear-itemtype.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../assets/seraphhorizons/itemtypes/largegear.json" Link="largegear-itemtype.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../assets/seraphhorizons/recipes/cooking/gear-degrease.json" Link="gear-degrease-recipes.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../assets/seraphhorizons/recipes/barrel/gear-neutralize.json" Link="gear-neutralize-recipes.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The gear codes' readers, which must take them from GearCodes rather than spell them out. -->
    <None Include="../GearConsumers.cs;../PicklingTub/Core/TubConfig.cs" Link="gear-code-readers/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The pickling tub (#476) and the brine bath (#482): rules, batches, loss. -->
    <Compile Include="../PicklingTub/Core/**/*.cs" Link="PicklingTub/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Travelling merchants (#456): inn rules, the visit cycle, the conditions. -->
    <Compile Include="../Trading/Visitors/Core/**/*.cs" Link="Trading/Visitors/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The trade window (#436 playtest): its view model, hold timing, request guard, locked stock, the
         standing speech and the wire format. -->
    <Compile Include="../Trading/Window/Core/**/*.cs" Link="Trading/Window/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Pack version check: the comparison, and the lock the mod embeds, so the tests read the real one. -->
    <Compile Include="../PackCheck/Core/**/*.cs" Link="PackCheck/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- NaN motion diagnostics (#405): the first-NaN tracker, the frame ring and the report's formatting. -->
    <Compile Include="../NanMotion/Core/**/*.cs" Link="NanMotion/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../../../pack/lock.json" Link="pack-lock.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Settings follow the pack's defaults: the readers, the reconciler, the run; and the shipped
         snapshots, which the tests read with them. -->
    <Compile Include="../ConfigDefaults/Core/**/*.cs" Link="ConfigDefaults/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../assets/seraphhorizons/config/configdefaults/**" Link="configdefaults/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Pipes (unified pipes, cast pipes, the hand pump bridge): burst figures, the lead rule, the
         recipe cost filter, the ppex asset guard and the shipped patch it is held to. -->
    <Compile Include="../Pipes/Core/**/*.cs" Link="Pipes/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../assets/seraphhorizons/patches/unifiedpipes-ppex.json" Link="unifiedpipes-ppex.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../assets/seraphhorizons/recipes/grid/unifiedpipes.json" Link="unifiedpipes-grid.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The chain: the patch on the game's chute section (the hollow section), its anvil recipe and
         the chute recipes; this mod's soldering recipe, the angle (item and shape) and the pipe
         section; and the game's three files (1.22.7), the item and chutes trimmed to what the guard reads. -->
    <None Include="../assets/seraphhorizons/patches/unifiedpipes-chutesection.json" Link="unifiedpipes-chutesection.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../assets/seraphhorizons/recipes/grid/chutesection.json" Link="chutesection-grid.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../assets/seraphhorizons/itemtypes/angle.json" Link="angle-itemtype.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../assets/seraphhorizons/itemtypes/pipesection.json" Link="pipesection-itemtype.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../assets/seraphhorizons/shapes/item/angle.json" Link="angle-shape.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../assets/seraphhorizons/shapes/item/pipesection.json" Link="pipesection-shape.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Pipes/fixtures/game-chute*.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Better Ruins' blueprint chutes off: the patch and its file (0.6.4) trimmed to what the guard reads. -->
    <None Include="../assets/seraphhorizons/patches/unifiedpipes-betterruins.json" Link="unifiedpipes-betterruins.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Pipes/fixtures/betterruins-mechanical.json" Link="betterruins-mechanical.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Cast pipes: the smex mold patch, its clay-forming recipe, and smex 0.10.1's two mold
         blocktypes trimmed to what the guard reads. -->
    <None Include="../assets/seraphhorizons/patches/castpipes-smexmold.json" Link="castpipes-smexmold.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../assets/seraphhorizons/recipes/clayforming/pipemold.json" Link="castpipes-pipemold.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Pipes/fixtures/smex-toolmold*.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The eidolon (#673): charge, stops, the slump pose, ownership and the wide pathfinder. -->
    <Compile Include="../Eidolon/Core/**/*.cs" Link="Eidolon/Core/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
