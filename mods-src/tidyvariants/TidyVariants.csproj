<Project Sdk="Microsoft.NET.Sdk">

  <!-- Universal mod that hides orientation and open/closed variants and groups the rest in the
       creative inventory and the handbook (README.md here, #252). Built from this repo,
       uploaded to the ModDB by hand, and pinned in pack.toml like any other mod. Atlas
       scenarios load this build instead of the pinned copy.

       Layout: Core/ is the game-independent rule engine (BCL only; its unit tests in tests/
       compile those files directly), Game/ and the top level hold the game-facing code.
       Everything under assets/ ships in the mod as is. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TidyVariants</AssemblyName>
    <RootNamespace>SeraphHorizons.TidyVariants</RootNamespace>
    <!-- Keep equal to modinfo.json's version; tools/tests/test_mods_src.py checks it. -->
    <Version>0.1.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Atlas copies a mod folder by its name: a plain bin/Debug would land in the same
         TestMods/Debug as another mods-src mod, and the game loads neither. -->
    <OutputPath>bin/$(Configuration)/tidyvariants/</OutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The unit tests are their own project (tests/TidyVariants.Tests.csproj). -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <Content Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The creative inventory and handbook dialogs are client types in the game's own library. -->
    <Reference Include="VintagestoryLib">
      <HintPath>$(VINTAGE_STORY)/VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(VINTAGE_STORY)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VINTAGE_STORY)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSCreativeMod">
      <HintPath>$(VINTAGE_STORY)/Mods/VSCreativeMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VINTAGE_STORY)/Lib/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- worldproperties files are the game's lenient JSON (unquoted keys); the game ships this. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VINTAGE_STORY)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <None Include="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- In the output folder too, so the build Atlas loads has its lang and config files. -->
    <None Update="assets/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- build/tidyvariants_<version>.zip, for the ModDB upload: the DLL and modinfo.json at the
       top level, as the game loads it, and assets/ with its folders. -->
  <Target Name="ModZip" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_ZipStage>$(IntermediateOutputPath)modzip/</_ZipStage>
      <_ZipOut>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', 'build', 'tidyvariants_$(Version).zip'))</_ZipOut>
    </PropertyGroup>
    <ItemGroup>
      <_ModAsset Include="assets/**" />
    </ItemGroup>
    <RemoveDir Directories="$(_ZipStage)" />
    <Copy SourceFiles="$(TargetPath);modinfo.json;CREDITS.md" DestinationFolder="$(_ZipStage)" />
    <Copy SourceFiles="@(_ModAsset)" DestinationFiles="@(_ModAsset->'$(_ZipStage)assets/%(RecursiveDir)%(Filename)%(Extension)')" />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_ZipOut)'))" />
    <ZipDirectory SourceDirectory="$(_ZipStage)" DestinationFile="$(_ZipOut)" Overwrite="true" />
    <Message Importance="high" Text="mod zip: $(_ZipOut)" />
  </Target>

</Project>
