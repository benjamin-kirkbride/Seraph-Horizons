// Tidy Variants pack overrides (#252, #258). Format: mods-src/tidyvariants/Core/README.md.
// Rules key on asset domain + code (+ kind), never modid. Group titles are lang keys in ../lang/en.json.
// Nothing here hides anything: hiding stays with the automatic orientation/open-closed rule.
{
  "version": 1,
  "rules": [

    // Ores (vanilla + GeologyAdditions + MaterialNeedsGeology, all in the game domain).
    // The ore block ore-{grade|potential}-{type}-{rock} and the ore item ore-{grade}-{ore}-{rock} share
    // codes, so every rule keys on kind. One tile per mineral; grade/potential and rock collapse.
    {"match": {"domain": "game", "code": "ore-*", "kind": "block"}, "group": {"id": "game-ore-{type}", "by": ["type"], "title": "tidyvariants:group-game-ore-{type}"}, "note": "Graded ore-{grade}-{type}-{rock}, gem ore-{potential}-{type}-{rock} (potential low/medium/high is not a grade word), ungraded ore-{type}-{rock}."},
    {"match": {"domain": "game", "code": "ore-*-*-*", "kind": "item"}, "group": {"id": "game-orechunk-{ore}", "by": ["ore"], "title": "tidyvariants:group-game-orechunk-{ore}"}, "note": "Graded ore chunks ore-{grade}-{ore}-{rock}; the ungraded ore-{ore} items have no rock and stay single."},
    {"match": {"domain": "game", "code": "crystalizedore-*", "kind": "item"}, "group": {"id": "game-crystalizedore-{ore}", "by": ["ore"], "title": "tidyvariants:group-game-crystalizedore-{ore}"}},
    {"match": {"domain": "game", "code": "looseores-*", "kind": "block"}, "group": {"id": "game-looseores-{ore}", "by": ["ore"], "title": "tidyvariants:group-game-looseores-{ore}"}},
    {"match": {"domain": "game", "code": "gem-*-rough", "kind": "item"}, "group": {"id": "game-gem-rough", "title": "tidyvariants:group-game-gem-rough"}, "note": "Handbook Declutterer: rough gems as one tile (the gem is a generic \"ore\" dimension)."},

    // Ported from Handbook Declutterer (CREDITS.md) unless noted. {base} is the family base code (the code
    // minus its variant values), so this one rule gives one tile per collectible type:
    // - attribute-stack blocks: clutter types, lamp types, mount type x wood, banner patterns (jonas-lamp is
    //   jonas-{type}, banner-banner is banner-{part}); clutter-devastation/-aquatic and banners are extensions;
    // - the 12 slanted roofing shapes ("material" mixes woods, clays, metal, slate and thatch, so it would stay
    //   meaningful);
    // - types whose clay colour, glaze or grain is a generic "type" (flowerpot and clayplanter also span two
    //   block types each: clay colour x raw/fired, and the glazed ones). storagevessel is an extension.
    {"match": {"domain": "game", "code": ["clutter", "clutter-devastation", "clutter-aquatic", "jonas-lamp", "antlermount", "banner-banner", "slantedroofing*", "flowerpot-*", "clayplanter-*", "storagevessel-*", "burnedbrick-*", "bread-*", "dough-*", "seeds-*"]}, "group": {"id": "game-{base}", "title": "tidyvariants:group-game-{base}"}},
    {"match": {"domain": "game", "code": "slantedroofing*-oak-*", "kind": "block"}, "prefer": true},
    {"match": {"domain": "game", "code": "clutteredbookshelf*", "kind": "block"}, "group": {"id": "game-clutteredbookshelf", "title": "tidyvariants:group-game-clutteredbookshelf"}, "note": "Three codes (clutteredbookshelf, -agedacacia, -withlore) in one tile. Extension."},
    {"match": {"domain": "game", "code": "figurehead-*", "kind": "block"}, "group": {"id": "game-figurehead-{type}", "by": ["type"], "title": "tidyvariants:group-game-figurehead-{type}"}, "note": "One tile per figurehead; its 12 wood stacks collapse."},
    {"match": {"domain": "butchering", "code": ["bloodbread-*", "blooddough-*"], "kind": "item"}, "group": {"id": "butchering-{base}", "title": "tidyvariants:group-butchering-{base}"}},
    {"match": {"domain": "game", "code": "shingle-*", "kind": "item"}, "group": {"id": "game-shingle-{state}", "by": ["state"], "title": "tidyvariants:group-game-shingle-{state}"}, "note": "Keep raw and fired apart; the clay colour collapses."},

    // Other resources.
    {"match": {"domain": "game", "code": ["amethyst", "clearquartz", "rosequartz", "smokyquartz"], "kind": "item"}, "group": {"id": "game-quartz-crystals", "title": "tidyvariants:group-game-quartz-crystals"}, "note": "Separate item types. Not ore-olivine: its chunk siblings would not come with it."},
    {"match": {"domain": "em", "code": ["crushed-ore-*", "powdered-ore-*"], "kind": "item"}, "group": {"id": "em-{base}", "title": "tidyvariants:group-em-{base}"}, "note": "\"type\" holds ore and pigment names, not rocks or metals."},

    // Armor: the tailored gambeson colour lives in "construction" (tailored-<colour>).
    // The other constructions group automatically per body part and construction (metal collapses).
    {"match": {"domain": "game", "code": "armor-*-tailored-*", "kind": "item"}, "group": {"id": "game-armor-tailored-{bodypart}", "by": ["bodypart"], "title": "tidyvariants:group-game-armor-tailored-{bodypart}"}},

    // Clothes: the garment is the value of one dimension (SelectiveMultiply), so families are listed codes
    // or code wildcards. All but the seed amulets are extensions.
    {"match": {"domain": "game", "code": ["clothes-neck-acorn-amulet", "clothes-neck-cypress-seed-amulet", "clothes-neck-larch-seed-amulet", "clothes-neck-pinecone-amulet", "clothes-neck-redwood-amulet", "clothes-neck-walnut-amulet", "clothes-nadiya-neck-acacia-amulet", "clothes-nadiya-neck-bamboo-seed-amulet", "clothes-nadiya-neck-birch-amulet", "clothes-nadiya-neck-cattail-root-amulet", "clothes-nadiya-neck-ebony-amulet", "clothes-nadiya-neck-kapok-amulet", "clothes-nadiya-neck-maple-amulet", "clothes-nadiya-neck-maple-red-amulet", "clothes-nadiya-neck-papyrus-root-amulet", "clothes-nadiya-neck-purpleheart-amulet", "clothes-nadiya-neck-tule-root-amulet"], "kind": "item"}, "group": {"id": "game-clothes-seedamulet", "title": "tidyvariants:group-game-clothes-seedamulet"}},
    {"match": {"domain": "game", "code": ["clothes-arm-acacia", "clothes-arm-bamboo", "clothes-arm-birch", "clothes-arm-cattail", "clothes-arm-cypress", "clothes-arm-ebony", "clothes-arm-kapok", "clothes-arm-larch", "clothes-arm-maple", "clothes-arm-maplered", "clothes-arm-oak", "clothes-arm-papyrus", "clothes-arm-pine", "clothes-arm-purpleheart", "clothes-arm-redwood", "clothes-arm-tule", "clothes-arm-walnut"], "kind": "item"}, "group": {"id": "game-clothes-seedbracelet", "title": "tidyvariants:group-game-clothes-seedbracelet"}},
    {"match": {"domain": "game", "code": "clothes-hand-cuffs*", "kind": "item"}, "group": {"id": "game-clothes-cuffs", "title": "tidyvariants:group-game-clothes-cuffs"}},
    {"match": {"domain": "game", "code": "clothes-head-liripipe*", "kind": "item"}, "group": {"id": "game-clothes-liripipe", "title": "tidyvariants:group-game-clothes-liripipe"}},
    {"match": {"domain": "game", "code": "clothes-shoulder-apron*", "kind": "item"}, "group": {"id": "game-clothes-apron", "title": "tidyvariants:group-game-clothes-apron"}},
    {"match": {"domain": "game", "code": "clothes-upperbody-kirtle*", "kind": "item"}, "group": {"id": "game-clothes-kirtle", "title": "tidyvariants:group-game-clothes-kirtle"}},
    {"match": {"domain": "game", "code": "clothes-lowerbody-braies*", "kind": "item"}, "group": {"id": "game-clothes-braies", "title": "tidyvariants:group-game-clothes-braies"}},
    {"match": {"domain": "game", "code": "clothes-lowerbody-hose*", "kind": "item"}, "group": {"id": "game-clothes-hose", "title": "tidyvariants:group-game-clothes-hose"}},
    {"match": {"domain": "game", "code": "clothes-face-funeralmask*", "kind": "item"}, "group": {"id": "game-clothes-funeralmask", "title": "tidyvariants:group-game-clothes-funeralmask"}},
    {"match": {"domain": "game", "code": "clothes-neck-nazar*", "kind": "item"}, "group": {"id": "game-clothes-nazar", "title": "tidyvariants:group-game-clothes-nazar"}},
    {"match": {"domain": "game", "code": "clothes-butterflypin-*", "kind": "item"}, "group": {"id": "game-clothes-butterflypin", "title": "tidyvariants:group-game-clothes-butterflypin"}},

    // Tankards and Goblets.
    {"match": {"domain": "tankardsandgoblets", "code": "goblet-jeweled-*", "kind": "block"}, "group": {"id": "tankardsandgoblets-goblet-jeweled", "title": "tidyvariants:group-tankardsandgoblets-goblet-jeweled"}, "note": "metal x jewel; the jewel is a gem name and would stay meaningful."},
    {"match": {"domain": "tankardsandgoblets", "code": "tankard-woodtype-*", "kind": "block"}, "group": {"id": "tankardsandgoblets-tankard-woodtype", "title": "tidyvariants:group-tankardsandgoblets-tankard-woodtype"}, "note": "binding mixes leather colours and metals, so it would stay meaningful."},

    // Shields (extension): one tile per construction; the metal x colour/wood x deco attribute stacks collapse.
    {"match": {"domain": "game", "code": "shield-*", "kind": "item"}, "group": {"id": "game-shield-{construction}", "by": ["construction"], "title": "tidyvariants:group-game-shield-{construction}"}},

    // DoorVariants: one tile per style; rock/brick colour/metal and wood collapse.
    {"match": {"domain": "doorvariants", "code": "*door*", "kind": "block"}, "group": {"id": "doorvariants-{style}", "by": ["style"], "title": "tidyvariants:group-doorvariants-{style}"}},

    // MoreRoads: rock (or clay colour, or wood) collapses; the ancient road style and the edging piece stay.
    {"match": {"domain": "moreroads", "code": ["ancientroad-*", "ancientroadslab-*", "ancientroadstairs-*"], "kind": "block"}, "group": {"id": "moreroads-{base}-{style}", "by": ["style"], "title": "tidyvariants:group-moreroads-{base}-{style}"}},
    {"match": {"domain": "moreroads", "code": ["stoneroad3*", "stonepath*", "stonefootpath-*", "clayroad*"], "kind": "block"}, "group": {"id": "moreroads-{base}", "title": "tidyvariants:group-moreroads-{base}"}},
    {"match": {"domain": "moreroads", "code": ["edgestone-*", "edgebrick-*", "edgewood-*", "edgeclay-*"], "kind": "block"}, "group": {"id": "moreroads-{base}-{corner}", "by": ["corner"], "title": "tidyvariants:group-moreroads-{base}-{corner}"}},

    // ExpandedFoods: its own handbook groupBy ("<type>-*") already makes one tile per type (honorShippedGroupBy);
    // this only titles the biggest ones. Food Shelves and Purposeful Storage need no rules at all: their wood/rock
    // stacks (attr:FSAttributes.wood, attr:PSAttributes.*) collapse by value and their groupBy joins the types.
    {"match": {"domain": "expandedfoods", "code": ["breadedvegetable-*", "breadedmeatnugget-*", "cookedmushroom-*", "cookedchoppedmushroom-*", "stuffedpepper-*", "sausage-*", "sausagesnake-*", "sausagefish-*", "sausagecrab-*", "breadedmushroom-*", "breadedfishnugget-*", "breadedball-*", "cookedchoppedvegetable-*", "cookedveggie-*", "choppedmushroom-*", "choppedvegetable-*", "gelatin-*", "hardtack-*", "dryfruit-*", "candiedfruit-*", "agedmeat-*", "meatnugget-*"], "kind": "item"}, "group": {"id": "expandedfoods-{base}", "title": "tidyvariants:group-expandedfoods-{base}"}},

    // Alchemy herb racks: wood x metal, metal, and clay colour x raw/fired collapse.
    {"match": {"domain": "alchemy", "code": ["herbrack-*", "herbrackhook-*", "herbracktop-*", "herbrackmold-*"]}, "group": {"id": "alchemy-{base}", "title": "tidyvariants:group-alchemy-{base}"}}
  ]
}
