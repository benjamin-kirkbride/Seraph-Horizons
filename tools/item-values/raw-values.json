  "defaults": [
    { "category": "earth", "match": "^(rock|stone|gravel|sand|soil|dirt|clay|mud|peat|loam)(-|$)", "value": 0.01 },
    { "category": "wood", "match": "^(log|stick|firewood|bark|branch|twig)(-|$)", "value": 0.03 },
    { "category": "plants", "match": "^(flower|fern|leaves|grass|tallgrass|vine|wildvine|seaweed|plant|reed|moss|lichen|herb)(-|$)", "value": 0.005 },
    { "category": "seeds", "match": "(^|-)(seeds?|treeseed|sapling|cutting|cuttings|spores?)(-|$)", "value": 0.02 },
    { "category": "crops", "match": "^(fruit|vegetable|grain|legume|mushroom|berry|berries|nut|melon|squash|root)(-|$)", "value": 0.03 },
    { "category": "meat", "match": "(meat|fish|poultry|crab|snake)[^-]*-raw|^(fishraw|crabmeat|snakemeat|fisheggs)", "value": 0.1 },
    { "category": "hides", "match": "^(hide|pelt|fur)(-|$)", "value": 0.5 },
    { "category": "ore", "match": "^(ore|nugget|crystal|gem)(-|$)", "value": 0.1 },
    { "category": "liquids", "match": "portion", "value": 0.0005 }
  ],

  "traderFallback": {
    "about": "A leaf nothing above prices, sold or bought by vanilla traders: the mean over its trader entries of price per item, times 'sells' for what traders sell and 'buys' for what they buy (vanilla buys at about half its sell price).",
    "sells": 0.7,
    "buys": 1.4
  }
