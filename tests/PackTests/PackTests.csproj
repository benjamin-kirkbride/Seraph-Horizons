<Project Sdk="Microsoft.NET.Sdk">

  <!-- Atlas scenarios for the whole pack: boots a real headless Vintage Story server
       in-process with every locked mod (staged into build/mods by `packtool.py fetch`). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PackModsDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'build', 'mods'))</PackModsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Pixnop.Atlas.XUnit" Version="0.15.0" />
    <!-- Validates the export against schema/recipe-export.schema.json (draft 2020-12). -->
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
    </Reference>
    <!-- The recipe registries' accessors (GetSmithingRecipes and so on) are extension methods here. -->
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VINTAGE_STORY)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- SeraphHorizonsModScenarios runs the game's entity selection (GameMain) on the server's world. -->
    <Reference Include="VintagestoryLib">
      <HintPath>$(VINTAGE_STORY)/VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ChiselRotationFixScenarios places BetterRuins schematics as GenStructures does. -->
    <Reference Include="VSEssentials">
      <HintPath>$(VINTAGE_STORY)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ConstructionHelpFixScenarios reverse-patches the game's method to compare against it. -->
    <Reference Include="0Harmony">
      <HintPath>$(VINTAGE_STORY)/Lib/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- CreativeModTabsScenarios round-trips the mod's network packet through the game's protobuf-net. -->
    <Reference Include="protobuf-net">
      <HintPath>$(VINTAGE_STORY)/Lib/protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VINTAGE_STORY)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Referenced as a library, not loaded as a mod: scenarios call Exporter.Build themselves. -->
    <ProjectReference Include="../../tools/recipe-export/SeraphExport.csproj" />
    <!-- Loaded as a mod: scenarios run against this build, not the copy pinned from the ModDB. -->
    <ProjectReference Include="../../mods-src/allowedvariantsfix/AllowedVariantsFix.csproj">
      <AtlasMod>true</AtlasMod>
    </ProjectReference>
    <ProjectReference Include="../../mods-src/constructionhelpfix/ConstructionHelpFix.csproj">
      <AtlasMod>true</AtlasMod>
    </ProjectReference>
    <ProjectReference Include="../../mods-src/seraphhorizons/SeraphHorizons.csproj">
      <AtlasMod>true</AtlasMod>
    </ProjectReference>
    <ProjectReference Include="../../mods-src/chiselrotationfix/ChiselRotationFix.csproj">
      <AtlasMod>true</AtlasMod>
    </ProjectReference>
    <None Include="../../schema/recipe-export.schema.json" Link="recipe-export.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../pack/lock.json" Link="lock.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../pack/known-errors.json" Link="known-errors.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- ModConfig files seeded into a class's server by [AtlasDataFiles]. -->
    <None Include="fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Feed every staged pack mod to Atlas. [assembly: AtlasMods(...)] only takes constant
    paths, so instead we write Atlas's generated manifest (atlas-mods.generated.txt: one
    absolute zip/folder path per line, appended after attribute paths at discovery time).
    Runs after Build, i.e. after Atlas's own WriteAtlasModManifest (BeforeTargets=Build),
    which rewrites the file with the <AtlasMod> references (mods-src/); these lines are
    appended after them. A pinned copy of a mods-src mod is left out, so the game loads the
    local build and not two mods with one modid: its ModDB zip is named after the modid.
  -->
  <Target Name="WritePackModManifest" AfterTargets="Build">
    <ItemGroup>
      <_PackModZip Include="$(PackModsDir)*.zip" Exclude="$(PackModsDir)allowedvariantsfix_*.zip;$(PackModsDir)constructionhelpfix_*.zip;$(PackModsDir)seraphhorizons_*.zip;$(PackModsDir)chiselrotationfix_*.zip" />
      <_PackModDir Include="$([System.IO.Directory]::GetDirectories('$(PackModsDir)'))" Condition="Exists('$(PackModsDir)')" />
    </ItemGroup>
    <Error Condition="'@(_PackModZip)@(_PackModDir)' == ''"
           Text="No mods staged in $(PackModsDir). Run `python3 tools/packtool.py fetch` first." />
    <WriteLinesToFile File="$(TargetDir)atlas-mods.generated.txt"
                      Lines="@(_PackModZip->'%(FullPath)');@(_PackModDir)" Overwrite="false" />
  </Target>

</Project>
